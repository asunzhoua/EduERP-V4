<!-- pages/student/leave-records/leave-records.wxml -->
<view class="container">
  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 错误 -->
  <view class="error-state" wx:elif="{{error}}">
    <text class="error-text">{{error}}</text>
    <view class="retry-btn" bindtap="loadRecords">点击重试</view>
  </view>

  <!-- 内容 -->
  <block wx:else>
    <!-- 状态筛选 -->
    <scroll-view scroll-x class="filter-row">
      <view class="chip {{filterStatus === '' ? 'on' : ''}}" bindtap="onFilter" data-status="">全部</view>
      <view class="chip {{filterStatus === 'PENDING' ? 'on' : ''}}" bindtap="onFilter" data-status="PENDING">待审批</view>
      <view class="chip {{filterStatus === 'APPROVED' ? 'on' : ''}}" bindtap="onFilter" data-status="APPROVED">已通过</view>
      <view class="chip {{filterStatus === 'REJECTED' ? 'on' : ''}}" bindtap="onFilter" data-status="REJECTED">已拒绝</view>
    </scroll-view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{records.length === 0}}">
      <view class="ic ic-list empty-ic"></view>
      <text class="empty-text">暂无申请记录</text>
    </view>

    <!-- 申请列表 -->
    <view class="record-list" wx:else>
      <view class="record-card" wx:for="{{records}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
        <view class="record-head">
          <text class="record-type">{{item.typeText}}</text>
          <text class="badge {{item.status === 'APPROVED' ? 'badge-present' : item.status === 'REJECTED' ? 'badge-absent' : 'badge-pending'}}">{{item.statusText}}</text>
        </view>
        <view class="record-row"><text class="record-label">课程</text><text class="record-value">{{item.courseName || '--'}}</text></view>
        <view class="record-row"><text class="record-label">日期</text><text class="record-value">{{item.date || '--'}}</text></view>
        <view class="record-row"><text class="record-label">原因</text><text class="record-value reason">{{item.reason || '--'}}</text></view>
        <view class="record-foot">
          <text class="record-time">{{item.createdAt || '--'}}</text>
          <view class="ic ic-chevron"></view>
        </view>
      </view>
    </view>
  </block>
</view>
