/* pages/student/points-mall/points-mall.wxss · 暖杏奶油 */
.container {
  padding: 150rpx 24rpx 24rpx;
  background: var(--bg, #FAF6F0);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 孩子切换条 */
.child-switch-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 16rpx 24rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #555;
}
.child-switch-label { font-weight: 500; }
.child-switch-arrow { color: #A64E1D; }

/* 顶部余额：固定不随列表滚动 */
.balance-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 30;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  background: var(--gradient-primary);
  border-radius: 0 0 28rpx 28rpx;
  padding: 30rpx 32rpx;
  box-shadow: var(--shadow-md, 0 8rpx 24rpx rgba(120,80,40,.18));
}

.balance-label {
  font-size: 26rpx;
  color: rgba(255,255,255,.85);
}

.balance-num {
  font-size: 56rpx;
  font-weight: 800;
  color: #FFFFFF;
  font-variant-numeric: tabular-nums;
}

/* 商品列表：两列网格 + 精简卡片 */
.product-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28rpx;
}

.product-card {
  display: flex;
  flex-direction: column;
  background: #FFFFFF;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
}

.product-img-wrap {
  position: relative;
  width: 100%;
  height: 260rpx;
}

.product-img {
  width: 100%;
  height: 260rpx;
}

.product-img-ph {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--accent-soft, #FBEEE2);
}

.product-img-ph .ic {
  width: 92rpx;
  height: 92rpx;
}

.product-stock {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  background: rgba(46,42,37,.55);
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.product-body {
  padding: 22rpx 24rpx 24rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.product-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.product-price {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--accent-deep, #A64E1D);
  font-variant-numeric: tabular-nums;
}

.product-price .unit {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--muted, #6F675D);
  margin-left: 4rpx;
}

.exchange-btn {
  font-size: 22rpx;
  color: #FFFFFF;
  background: var(--accent-deep, #A64E1D);
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  font-weight: 600;
}

.exchange-btn.disabled {
  background: var(--border, #EDE5DA);
  color: var(--faint, #9B9084);
}

/* 底部：当前积分 + 返回 */
.container {
  padding-bottom: 180rpx;
}

.mall-foot {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-top: 2rpx solid var(--border, #EDE5DA);
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 30;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.mf-bal {
  font-size: 26rpx;
  color: var(--muted, #6F675D);
}

.mf-bal-num {
  color: var(--accent-deep, #A64E1D);
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.mf-back {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  color: var(--accent-deep, #A64E1D);
  border: 3rpx solid var(--accent, #D97B3E);
  border-radius: 999rpx;
  padding: 18rpx 36rpx;
  font-size: 26rpx;
  font-weight: 600;
}
