/* pages/student/classes.wxss */
.container {
  padding: 20rpx;
  background: #FAF6F0;
  min-height: 100vh;
}

/* 孩子切换条 */
.child-switch-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 16rpx 24rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #555;
}
.child-switch-label { font-weight: 500; }
.child-switch-arrow { color: #A64E1D; }

.page-header {
  padding: 20rpx 0;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #2E2A25;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #EDE5DA;
  border-top-color: #D97B3E;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #9B9084;
}

.error-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 30rpx;
  background: #fff;
  border-radius: 24rpx;
}

.error-text {
  font-size: 28rpx;
  color: #9B9084;
}

.retry-btn {
  font-size: 28rpx;
  color: #D97B3E;
  margin-top: 20rpx;
  padding: 10rpx 30rpx;
  border: 2rpx solid #D97B3E;
  border-radius: 16rpx;
}

.class-list {
  padding-top: 10rpx;
}

.class-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.class-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.class-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #2E2A25;
}

.class-code {
  font-size: 22rpx;
  color: #9B9084;
}

.class-progress {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-bar {
  flex: 1;
  height: 16rpx;
  background: #FAF6F0;
  border-radius: 16rpx;
  overflow: hidden;
  margin-right: 16rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #D97B3E, #D97B3E);
  border-radius: 16rpx;
}

.progress-text {
  font-size: 24rpx;
  color: #6F675D;
}

.class-meta {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #9B9084;
}

.empty {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
  color: #9B9084;
  font-size: 28rpx;
}
