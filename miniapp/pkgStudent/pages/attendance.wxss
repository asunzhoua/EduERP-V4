/* pages/student/attendance.wxss · 暖杏奶油 */
.container {
  padding: 24rpx;
  background: var(--bg, #FAF6F0);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 孩子切换条 */
.child-switch-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 16rpx 24rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #555;
}
.child-switch-label { font-weight: 500; }
.child-switch-arrow { color: #A64E1D; }

.loading-state,
.error-state,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid var(--accent-soft, #FBEEE2);
  border-top-color: var(--accent, #D97B3E);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text,
.empty-text {
  font-size: 26rpx;
  color: var(--faint, #9B9084);
}

.error-text {
  font-size: 28rpx;
  color: var(--muted, #6F675D);
}

.retry-btn {
  font-size: 28rpx;
  color: var(--accent-deep, #A64E1D);
  margin-top: 20rpx;
  padding: 10rpx 30rpx;
  border: 2rpx solid var(--accent, #D97B3E);
  border-radius: 16rpx;
}

/* 出勤汇总 */
.stats-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
}

.att-rate {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.att-rate-value {
  font-size: 72rpx;
  font-weight: 800;
  color: var(--growth, #5B7A66);
  font-variant-numeric: tabular-nums;
}

.att-rate-label {
  font-size: 24rpx;
  color: var(--faint, #9B9084);
}

.rate-bar {
  width: 100%;
  height: 14rpx;
  background: #F1EBE1;
  border-radius: 999rpx;
  overflow: hidden;
  margin-top: 16rpx;
}

.rate-fill {
  height: 100%;
  background: var(--growth, #5B7A66);
  border-radius: 999rpx;
}

.att-grid {
  display: flex;
  justify-content: space-around;
  margin-top: 28rpx;
}

.att-g {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.att-v {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
  font-variant-numeric: tabular-nums;
}

.att-v.present { color: var(--growth, #5B7A66); }
.att-v.absent { color: var(--danger, #C4483F); }
.att-v.late { color: var(--warning, #D98E2B); }
.att-v.leave { color: var(--muted, #6F675D); }

.att-l {
  font-size: 22rpx;
  color: var(--faint, #9B9084);
  margin-top: 4rpx;
}

/* 出勤列表 */
.att-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.att-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}

.att-main {
  flex: 1;
  min-width: 0;
}

.att-date {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
  font-variant-numeric: tabular-nums;
}

.att-course {
  font-size: 25rpx;
  color: var(--muted, #6F675D);
  margin-top: 6rpx;
}

.att-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.att-status {
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.att-status.status-PRESENT,
.att-status.status-ONLINE {
  background: var(--growth-soft, #EAF1EC);
  color: var(--growth-deep, #3E5B4A);
}

.att-status.status-ABSENT {
  background: var(--danger-soft, #F9E9E7);
  color: var(--danger, #C4483F);
}

.att-status.status-LATE {
  background: var(--warning-soft, #FCF0DF);
  color: #A86A17;
}

.att-status.status-LEAVE,
.att-status.status-SICK,
.att-status.status-MAKEUP {
  background: #EFEAE3;
  color: var(--muted, #6F675D);
}

.att-status.status-OFFLINE {
  background: var(--accent-soft, #FBEEE2);
  color: var(--accent-deep, #A64E1D);
}

.att-status.status-null {
  background: #F1EDE6;
  color: var(--faint, #9B9084);
}

.deduction-skip-badge {
  font-size: 20rpx;
  color: var(--muted, #6F675D);
  margin-top: 6rpx;
}
