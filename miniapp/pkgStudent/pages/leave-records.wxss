/* pages/student/leave-records/leave-records.wxss · 暖杏奶油 */
.container {
  padding: 24rpx;
  background: var(--bg, #FAF6F0);
  min-height: 100vh;
  box-sizing: border-box;
}

.loading-state,
.error-state,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid var(--accent-soft, #FBEEE2);
  border-top-color: var(--accent, #D97B3E);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text,
.empty-text {
  font-size: 26rpx;
  color: var(--faint, #9B9084);
}

.error-text {
  font-size: 28rpx;
  color: var(--muted, #6F675D);
}

.retry-btn {
  font-size: 28rpx;
  color: var(--accent-deep, #A64E1D);
  margin-top: 20rpx;
  padding: 10rpx 30rpx;
  border: 2rpx solid var(--accent, #D97B3E);
  border-radius: 16rpx;
}

.empty-ic {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  opacity: .5;
}

/* 筛选 */
.filter-row {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.filter-row .chip {
  display: inline-flex;
  margin-right: 16rpx;
}

/* 申请列表 */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
}

.record-card:active {
  transform: scale(0.99);
}

.record-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.record-type {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
}

.record-row {
  display: flex;
  padding: 6rpx 0;
}

.record-label {
  width: 96rpx;
  flex: none;
  font-size: 25rpx;
  color: var(--faint, #9B9084);
}

.record-value {
  flex: 1;
  font-size: 26rpx;
  color: var(--muted, #6F675D);
}

.record-value.reason {
  color: var(--fg, #2E2A25);
}

.record-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--border, #EDE5DA);
}

.record-time {
  font-size: 22rpx;
  color: var(--faint, #9B9084);
}

.record-foot .ic-chevron {
  width: 30rpx;
  height: 30rpx;
}
