<!-- pages/student/leave-apply/leave-apply.wxml -->
<view class="container">
  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 表单 -->
  <block wx:else>
    <view class="form-card">
      <!-- 选择孩子 -->
      <view class="form-row">
        <text class="lab">孩子 <text class="req">*</text></text>
        <picker mode="selector" range="{{childLabels}}" bindchange="onSelectChild">
          <view class="val">
            {{selectedChild ? selectedChild.name : ''}}
            <view class="ic ic-chevron"></view>
          </view>
        </picker>
      </view>

      <!-- 选择课程 -->
      <view class="form-row" bindtap="onSelectCourse">
        <text class="lab">课程 <text class="req">*</text></text>
        <view class="val {{selectedCourse ? '' : 'ph'}}">
          {{selectedCourse ? selectedCourse.courseName + ' · ' + selectedCourse.lessonDate + ' ' + selectedCourse.startTime + '~' + selectedCourse.endTime : '请选择课程'}}
          <view class="ic ic-chevron"></view>
        </view>
      </view>

      <!-- 异常类型 -->
      <view class="form-row">
        <text class="lab">异常类型 <text class="req">*</text></text>
        <view class="chips">
          <view class="chip {{leaveType === 'SICK' ? 'on' : ''}}" bindtap="onSelectType" data-type="SICK">病假</view>
          <view class="chip {{leaveType === 'PERSONAL' ? 'on' : ''}}" bindtap="onSelectType" data-type="PERSONAL">事假</view>
        </view>
      </view>

      <!-- 原因 -->
      <view class="form-block">
        <text class="lab">请假原因 <text class="req">*</text></text>
        <textarea class="remark" placeholder="请详细描述请假原因..." placeholder-class="ph" value="{{reason}}" bindinput="onInputReason" maxlength="500" />
        <text class="char-count">{{reason.length}}/500</text>
      </view>
    </view>

    <button class="submit-btn" bindtap="onSubmit" disabled="{{submitting}}">
      {{submitting ? '提交中...' : '提交申请'}}
    </button>
    <view class="form-note">提交后由老师确认，可在「我的申请」查看进度</view>
  </block>
</view>
