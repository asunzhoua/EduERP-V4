<!-- pages/student/attendance.wxml -->
<view class="container">
  <!-- 孩子切换条 -->
  <view class="child-switch-bar" wx:if="{{isParent}}" bindtap="onSwitchChild">
    <text class="child-switch-label">当前孩子：{{currentChildName}}</text>
    <text class="child-switch-arrow">切换 ›</text>
  </view>

  <!-- 加载 -->
  <view wx:if="{{loading}}" class="loading-state">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 错误 -->
  <view wx:elif="{{error}}" class="error-state">
    <text class="error-text">{{error}}</text>
    <view class="retry-btn" bindtap="loadAttendance">重试</view>
  </view>

  <!-- 空 -->
  <view wx:elif="{{attendanceList.length === 0}}" class="empty-state">
    <text class="empty-text">暂无出勤记录</text>
  </view>

  <!-- 列表 -->
  <block wx:else>
    <!-- 出勤汇总 -->
    <view class="stats-card">
      <view class="att-rate">
        <text class="att-rate-value">{{stats.attendanceRate}}%</text>
        <text class="att-rate-label">到课率</text>
        <view class="rate-bar">
          <view class="rate-fill" style="width: {{stats.attendanceRate}}%;"></view>
        </view>
      </view>
      <view class="att-grid">
        <view class="att-g"><view class="att-v present">{{stats.present}}</view><view class="att-l">到课</view></view>
        <view class="att-g"><view class="att-v absent">{{stats.absent}}</view><view class="att-l">缺勤</view></view>
        <view class="att-g"><view class="att-v late">{{stats.late}}</view><view class="att-l">迟到</view></view>
        <view class="att-g"><view class="att-v leave">{{stats.leave}}</view><view class="att-l">请假</view></view>
      </view>
    </view>

    <!-- 出勤列表 -->
    <view class="att-list">
      <view class="att-item" wx:for="{{attendanceList}}" wx:key="id">
        <view class="att-main">
          <view class="att-date">{{item.lessonDate || '待定'}}</view>
          <view class="att-course">{{item.courseName || '未知课程'}}{{item.className ? ' · ' + item.className : ''}}</view>
        </view>
        <view class="att-right">
          <view class="att-status {{item.statusClass}}">{{item.statusText}}</view>
          <view wx:if="{{item.deductionSkippedReason}}" class="deduction-skip-badge">未扣课时</view>
        </view>
      </view>
    </view>
  </block>
</view>
