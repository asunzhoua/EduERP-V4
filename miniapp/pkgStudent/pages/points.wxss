/* pages/student/points/points.wxss · 暖杏奶油 */
.container {
  padding: 24rpx;
  background: var(--bg, #FAF6F0);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 孩子切换条 */
.child-switch-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 16rpx 24rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #555;
}
.child-switch-label { font-weight: 500; }
.child-switch-arrow { color: #A64E1D; }

/* 积分总览 */
.points-card {
  background: var(--gradient-primary);
  border-radius: 32rpx;
  padding: 40rpx 32rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-md, 0 8rpx 24rpx rgba(120,80,40,.18));
}

.points-label {
  font-size: 26rpx;
  color: rgba(255,255,255,.82);
}

.points-num {
  margin-top: 6rpx;
  font-size: 92rpx;
  font-weight: 800;
  line-height: 1.05;
  color: #FFFFFF;
  font-variant-numeric: tabular-nums;
}

.points-num .unit {
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(255,255,255,.82);
  margin-left: 6rpx;
}

.points-sub {
  display: flex;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(255,255,255,.22);
}

.sub-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.sub-v {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  font-variant-numeric: tabular-nums;
}

.sub-l {
  font-size: 22rpx;
  color: rgba(255,255,255,.78);
  margin-top: 4rpx;
}

/* 商城入口：暖色渐变横幅 */
.mall-entry {
  display: flex;
  align-items: center;
  gap: 28rpx;
  background: var(--gradient-primary);
  border-radius: 36rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-md, 0 8rpx 24rpx rgba(120,80,40,.18));
}

.me-icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.me-icon .ic {
  width: 60rpx;
  height: 60rpx;
}

.me-mid {
  flex: 1;
  min-width: 0;
}

.me-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.me-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,.82);
  margin-top: 6rpx;
}

.me-go {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #FFFFFF;
  color: var(--accent-deep, #A64E1D);
  font-size: 26rpx;
  font-weight: 600;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  flex: none;
}

.me-go .ic {
  width: 28rpx;
  height: 28rpx;
}

/* 积分流水 */
.tx-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}

.tx-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.tx-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
}

.tx-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--border, #EDE5DA);
}

.tx-item:last-child {
  border-bottom: none;
}

.tx-main {
  flex: 1;
  min-width: 0;
}

.tx-desc {
  font-size: 28rpx;
  color: var(--fg, #2E2A25);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tx-date {
  font-size: 22rpx;
  color: var(--faint, #9B9084);
  margin-top: 6rpx;
  font-variant-numeric: tabular-nums;
}

.tx-amount {
  flex: none;
  font-size: 32rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.tx-amount.earn { color: var(--growth, #5B7A66); }
.tx-amount.spend { color: var(--danger, #C4483F); }

.tx-balance {
  flex: none;
  margin-left: 20rpx;
  font-size: 22rpx;
  color: var(--faint, #9B9084);
  font-variant-numeric: tabular-nums;
}
