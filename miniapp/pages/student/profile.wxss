/* pages/student/profile.wxss · 暖杏奶油 */
.container {
  padding: 24rpx;
  padding-bottom: 40rpx;
  background: var(--bg, #FAF6F0);
  min-height: 100vh;
  box-sizing: border-box;
}

/* === 顶部个人信息 === */
.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx 30rpx 40rpx;
  background: var(--gradient-header, linear-gradient(160deg, #FBE6CF, #FAF6F0));
  border-radius: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.avatar-area {
  margin-bottom: 20rpx;
}

.avatar-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8A25E, #A64E1D);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255,255,255,.5);
}

.avatar-text {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
}

.profile-name {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
  margin-bottom: 8rpx;
}

.profile-code {
  font-size: 26rpx;
  color: var(--muted, #6F675D);
}

/* === 基础信息卡片 === */
.info-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--border, #EDE5DA);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: var(--muted, #6F675D);
}

.info-value {
  font-size: 28rpx;
  color: var(--fg, #2E2A25);
  font-weight: 500;
}

/* === 通用 Section 卡片 === */
.section-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

/* === 合同状态 === */
.contract-summary {
  font-size: 24rpx;
  color: var(--accent-deep, #A64E1D);
  font-weight: normal;
}

.contract-summary.expiring {
  color: var(--warning, #D98E2B);
  margin-left: 16rpx;
}

.contract-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--border, #EDE5DA);
}

.contract-item:last-child {
  border-bottom: none;
}

.contract-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.contract-subject {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
}

.contract-tag {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.status-active {
  background: var(--growth-soft, #EAF1EC);
  color: var(--growth-deep, #3E5B4A);
}

.status-expiring {
  background: var(--warning-soft, #FCF0DF);
  color: #A86A17;
}

.status-expired {
  background: var(--danger-soft, #F9E9E7);
  color: var(--danger, #C4483F);
}

.status-suspended {
  background: #EFEAE3;
  color: var(--muted, #6F675D);
}

.status-unknown {
  background: #F1EDE6;
  color: var(--faint, #9B9084);
}

.contract-detail {
  padding-left: 10rpx;
}

.contract-detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.detail-label {
  font-size: 26rpx;
  color: var(--faint, #9B9084);
}

.detail-value {
  font-size: 26rpx;
  color: var(--fg, #2E2A25);
}

.detail-value.highlight {
  color: var(--accent-deep, #A64E1D);
  font-weight: 700;
}

/* 进度条 */
.progress-bar-wrap {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.progress-bar {
  flex: 1;
  height: 14rpx;
  background: #F1EBE1;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--accent, #D97B3E);
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 22rpx;
  color: var(--faint, #9B9084);
  margin-left: 12rpx;
  min-width: 60rpx;
  text-align: right;
}

/* === 学习概览 === */
.overview-grid {
  display: flex;
  justify-content: space-around;
  padding: 10rpx 0;
}

.overview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.overview-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
  font-variant-numeric: tabular-nums;
}

.overview-value.used {
  color: var(--accent-deep, #A64E1D);
}

.overview-value.remain {
  color: var(--accent-deep, #A64E1D);
}

.overview-value.rate {
  color: var(--growth, #5B7A66);
}

.overview-label {
  font-size: 24rpx;
  color: var(--faint, #9B9084);
  margin-top: 8rpx;
}

/* === 最近课程 === */
.lesson-item {
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--border, #EDE5DA);
}

.lesson-item:last-child {
  border-bottom: none;
}

.lesson-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.lesson-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--fg, #2E2A25);
}

.lesson-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.status-present {
  background: var(--growth-soft, #EAF1EC);
  color: var(--growth-deep, #3E5B4A);
}

.status-absent {
  background: var(--danger-soft, #F9E9E7);
  color: var(--danger, #C4483F);
}

.status-late {
  background: var(--warning-soft, #FCF0DF);
  color: #A86A17;
}

.status-leave {
  background: #EFEAE3;
  color: var(--muted, #6F675D);
}

.status-pending {
  background: #F1EDE6;
  color: var(--faint, #9B9084);
}

.lesson-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.lesson-info {
  font-size: 24rpx;
  color: var(--muted, #6F675D);
}

.lesson-time {
  font-size: 24rpx;
  color: var(--muted, #6F675D);
}

/* === 空状态 === */
.empty-hint {
  text-align: center;
  padding: 40rpx 0;
  color: var(--faint, #9B9084);
  font-size: 26rpx;
}

/* === 加载中 === */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--accent-soft, #FBEEE2);
  border-top-color: var(--accent, #D97B3E);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: var(--faint, #9B9084);
}

/* === 错误 === */
.error-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 30rpx;
  background: #fff;
  border-radius: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.error-text {
  font-size: 28rpx;
  color: var(--muted, #6F675D);
}

.retry-btn {
  font-size: 28rpx;
  color: var(--accent-deep, #A64E1D);
  margin-top: 20rpx;
  padding: 10rpx 30rpx;
  border: 2rpx solid var(--accent, #D97B3E);
  border-radius: 16rpx;
}
