.container {
  padding: 20rpx;
  background: #FAF6F0;
  min-height: 100vh;
}

/* 加载中 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #EDE5DA;
  border-top-color: #D97B3E;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #9B9084;
}

/* 错误状态 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.error-text {
  font-size: 28rpx;
  color: #9B9084;
  margin-bottom: 20rpx;
}

.retry-btn {
  font-size: 28rpx;
  color: #D97B3E;
  padding: 12rpx 40rpx;
  border: 2rpx solid #D97B3E;
  border-radius: 16rpx;
}

/* 信息卡片 */
.info-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #FAF6F0;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2E2A25;
}

.status-tag {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.status-PENDING {
  background: #FCF0DF;
  color: #D98E2B;
  border: 2rpx solid #FCF0DF;
}

.status-APPROVED {
  background: #FBEEE2;
  color: #D97B3E;
  border: 2rpx solid #FBEEE2;
}

.status-REJECTED {
  background: #F9E9E7;
  color: #C4483F;
  border: 2rpx solid #F9E9E7;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #FAF6F0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #9B9084;
  flex-shrink: 0;
}

.info-value {
  font-size: 26rpx;
  color: #2E2A25;
  text-align: right;
  flex: 1;
  margin-left: 20rpx;
}

/* 审批记录 */
.approval-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #FAF6F0;
}

.approval-item:last-child {
  border-bottom: none;
}

.approval-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.approval-operator {
  font-size: 26rpx;
  font-weight: bold;
  color: #2E2A25;
}

.approval-result {
  font-size: 24rpx;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
}

.result-pass {
  background: #FBEEE2;
  color: #D97B3E;
}

.result-reject {
  background: #F9E9E7;
  color: #C4483F;
}

.approval-opinion {
  display: block;
  font-size: 24rpx;
  color: #6F675D;
  margin-bottom: 6rpx;
}

.approval-time {
  display: block;
  font-size: 22rpx;
  color: #9B9084;
}

/* 空状态 */
.empty-block {
  display: flex;
  justify-content: center;
  padding: 30rpx 0;
  font-size: 26rpx;
  color: #9B9084;
}
