<!-- pages/student/subscribe/subscribe.wxml -->
<view class="container">
  <view class="page-header">
    <text class="page-title">消息订阅</text>
    <text class="page-sub">订阅后可在微信中接收通知。每条通知消耗 1 次订阅次数，可再次订阅增加次数。</text>
  </view>

  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view class="error-card" wx:elif="{{error}}">
    <text class="error-text">{{error}}</text>
    <text class="retry-btn" bindtap="loadData">点击重试</text>
  </view>

  <view class="template-list" wx:else>
    <view class="template-card" wx:for="{{templates}}" wx:key="templateType">
      <view class="template-top">
        <text class="template-name">{{item.templateName}}</text>
        <text class="template-quota" wx:if="{{item.quota > 0}}">剩余 {{item.quota}} 次</text>
        <text class="template-quota empty" wx:else>未订阅</text>
      </view>

      <view class="template-fields" wx:if="{{item.fieldDescriptions}}">
        <view class="field-row" wx:for="{{item.fields}}" wx:for-item="field" wx:key="*this">
          <text class="field-desc">{{item.fieldDescriptions[field]}}</text>
        </view>
      </view>

      <button class="subscribe-btn" size="mini" bindtap="onSubscribe" data-index="{{index}}">开启订阅</button>
    </view>

    <view class="empty-hint" wx:if="{{templates.length === 0}}">
      <text>暂无可用订阅模板，请联系管理员配置</text>
    </view>
  </view>
</view>
