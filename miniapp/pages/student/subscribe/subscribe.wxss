/* pages/student/subscribe/subscribe.wxss */
.container {
  min-height: 100vh;
  background: var(--bg, #FAF6F0);
  padding: 24rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.page-header {
  margin-bottom: 28rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--fg, #2E2A25);
}

.page-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--faint, #9B9084);
  line-height: 1.6;
}

.template-card {
  background: var(--card, #FFFFFF);
  border-radius: var(--radius-md, 28rpx);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
}

.template-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.template-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--fg, #2E2A25);
}

.template-quota {
  font-size: 24rpx;
  color: var(--accent-deep, #A64E1D);
  background: var(--accent-soft, #FBEEE2);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full, 999rpx);
}

.template-quota.empty {
  color: var(--faint, #9B9084);
  background: var(--border, #EDE5DA);
}

.template-fields {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border, #EDE5DA);
}

.field-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}

.field-desc {
  font-size: 26rpx;
  color: var(--muted, #6F675D);
}

.subscribe-btn {
  margin-top: 20rpx;
  background: var(--accent-deep, #A64E1D);
  color: #FFFFFF;
  border-radius: var(--radius-full, 999rpx);
  font-size: 26rpx;
  padding: 0 40rpx;
}

.subscribe-btn::after {
  border: none;
}

.loading-state,
.empty-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
  color: var(--faint, #9B9084);
  font-size: 28rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--border, #EDE5DA);
  border-top-color: var(--accent-deep, #A64E1D);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.error-card {
  background: var(--card, #FFFFFF);
  border-radius: var(--radius-md, 28rpx);
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.error-text {
  color: var(--danger, #C4483F);
  font-size: 28rpx;
}

.retry-btn {
  margin-top: 20rpx;
  color: var(--accent-deep, #A64E1D);
  font-size: 28rpx;
  text-decoration: underline;
}
