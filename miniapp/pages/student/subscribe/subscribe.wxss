/* pages/student/subscribe/subscribe.wxss */
.container {
  min-height: 100vh;
  background: #FAF6F0;
  padding: 24rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.page-header {
  margin-bottom: 28rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #2D2D2D;
}

.page-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #9B9084;
  line-height: 1.6;
}

.template-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.template-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.template-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D2D2D;
}

.template-quota {
  font-size: 24rpx;
  color: #A64E1D;
  background: rgba(166, 78, 29, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.template-quota.empty {
  color: #9B9084;
  background: rgba(155, 144, 132, 0.12);
}

.template-fields {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F2ECE4;
}

.field-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}

.field-desc {
  font-size: 26rpx;
  color: #6B6258;
}

.subscribe-btn {
  margin-top: 20rpx;
  background: #A64E1D;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 26rpx;
  padding: 0 40rpx;
}

.subscribe-btn::after {
  border: none;
}

.loading-state,
.empty-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
  color: #9B9084;
  font-size: 28rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #E8E0D6;
  border-top-color: #A64E1D;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.error-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.error-text {
  color: #B3261E;
  font-size: 28rpx;
}

.retry-btn {
  margin-top: 20rpx;
  color: #A64E1D;
  font-size: 28rpx;
  text-decoration: underline;
}
