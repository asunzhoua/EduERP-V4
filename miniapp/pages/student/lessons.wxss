/* pages/student/lessons.wxss · 暖杏奶油 */
.container {
  padding: 24rpx;
  background: var(--bg, #FAF6F0);
  min-height: 100vh;
  box-sizing: border-box;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid var(--accent-soft, #FBEEE2);
  border-top-color: var(--accent, #D97B3E);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: var(--faint, #9B9084);
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.error-text {
  font-size: 28rpx;
  color: var(--muted, #6F675D);
}

.retry-btn {
  font-size: 28rpx;
  color: var(--accent-deep, #A64E1D);
  margin-top: 20rpx;
  padding: 10rpx 30rpx;
  border: 2rpx solid var(--accent, #D97B3E);
  border-radius: 16rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: var(--faint, #9B9084);
}

/* 统计概览 */
.stats-card {
  display: flex;
  justify-content: space-around;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 16rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat .v {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--fg, #2E2A25);
  font-variant-numeric: tabular-nums;
}

.stat .v.present { color: var(--growth, #5B7A66); }
.stat .v.absent { color: var(--danger, #C4483F); }
.stat .v.leave { color: var(--muted, #6F675D); }

.stat .l {
  font-size: 22rpx;
  color: var(--faint, #9B9084);
  margin-top: 6rpx;
}

/* 筛选 */
.filter-row {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.filter-row .chip {
  display: inline-flex;
  margin-right: 16rpx;
}

/* 课时列表 */
.lesson-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.lesson-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}

.l-date {
  flex: none;
  min-width: 150rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
  font-variant-numeric: tabular-nums;
}

.l-mid {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.l-course {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--fg, #2E2A25);
}

.l-sub {
  font-size: 23rpx;
  color: var(--muted, #6F675D);
  margin-top: 4rpx;
}

/* 课时余额 */
.balance-card {
  display: flex;
  justify-content: space-around;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 16rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
}

.balance-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.balance-item .v {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--fg, #2E2A25);
  font-variant-numeric: tabular-nums;
}

.balance-item .v.used { color: var(--muted, #6F675D); }
.balance-item .v.remain { color: var(--accent-deep, #A64E1D); }

.balance-item .l {
  font-size: 22rpx;
  color: var(--faint, #9B9084);
  margin-top: 6rpx;
}

/* 日期查询 */
.date-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.date-field {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: var(--bg, #FAF6F0);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--fg, #2E2A25);
  font-variant-numeric: tabular-nums;
}

.date-field.placeholder {
  color: var(--faint, #9B9084);
}

.date-sep {
  padding: 0 20rpx;
  font-size: 26rpx;
  color: var(--faint, #9B9084);
}

.date-btns {
  display: flex;
  margin-top: 20rpx;
  gap: 20rpx;
}

.date-btns .btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.date-btns .btn.reset {
  background: var(--bg, #FAF6F0);
  color: var(--muted, #6F675D);
  border: 2rpx solid var(--border, #EDE5DA);
}

.date-btns .btn.query {
  background: var(--accent-deep, #A64E1D);
  color: #FFFFFF;
}
