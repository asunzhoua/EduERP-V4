/* pages/student/index.wxss · 暖杏奶油 */
.container {
  padding: 24rpx;
  background: var(--bg, #FAF6F0);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ============ 家长「我的」 ============ */
.my-page {
  padding-top: 8rpx;
}

.profile-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 8rpx 28rpx;
}

.avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8A25E, #A64E1D);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(166,78,29,.3);
  flex: none;
}

.pn {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
}

.ps {
  font-size: 24rpx;
  color: var(--muted, #6F675D);
  margin-top: 6rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
  margin-bottom: 12rpx;
}

/* 孩子列表 */
.child-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--border, #EDE5DA);
}

.child-row:last-child {
  border-bottom: none;
}

.cr-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background-color: var(--accent-soft, #FBEEE2);
  color: var(--accent-deep, #A64E1D);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  flex: none;
}

.cr-mid {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.cr-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--fg, #2E2A25);
}

.cr-sub {
  font-size: 22rpx;
  color: var(--faint, #9B9084);
  margin-top: 2rpx;
}

.child-row .ic-chevron {
  width: 30rpx;
  height: 30rpx;
}

/* 添加小朋友行：虚线上边线区隔 */
.add-child-row {
  border-top: 2rpx dashed var(--border, #EDE5DA);
}

.add-avatar {
  background-color: #FFFFFF;
  border: 2rpx dashed var(--accent, #D97B3E);
  color: var(--accent, #D97B3E);
}

/* 功能菜单 */
.menu-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--border, #EDE5DA);
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-row text {
  flex: 1;
  margin-left: 20rpx;
  font-size: 29rpx;
  color: var(--fg, #2E2A25);
}

.mi {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background-color: var(--accent-soft, #FBEEE2);
  flex: none;
}

.menu-row .ic-chevron {
  width: 30rpx;
  height: 30rpx;
}

/* 消息订阅 */
.sub-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--border, #EDE5DA);
  font-size: 29rpx;
  color: var(--fg, #2E2A25);
}

.sub-row:last-child {
  border-bottom: none;
}

.switch {
  width: 80rpx;
  height: 46rpx;
  border-radius: 999rpx;
  background: #E3DCD2;
  position: relative;
  transition: background .2s;
}

.switch::after {
  content: "";
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,.2);
  transition: left .2s;
}

.switch.on {
  background: var(--accent, #D97B3E);
}

.switch.on::after {
  left: 38rpx;
}

/* 退出登录 */
.logout {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 999rpx;
  border: 3rpx solid var(--danger, #C4483F);
  color: var(--danger, #C4483F);
  font-size: 30rpx;
  font-weight: 600;
  background: #FFFFFF;
  margin-top: 8rpx;
}

.logout::after {
  border: none;
}

.logout:active {
  background: var(--danger-soft, #F9E9E7);
}

/* ============ 教师/管理员个人中心（保留） ============ */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.error-ic {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 16rpx;
}

.error-text {
  font-size: 28rpx;
  color: var(--muted, #6F675D);
}

.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 30rpx;
  background: var(--gradient-header, linear-gradient(160deg, #FBE6CF, #FAF6F0));
  border-radius: 28rpx;
  margin-bottom: 24rpx;
}

.avatar-area {
  position: relative;
}

.avatar-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
}

.avatar-circle {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8A25E, #A64E1D);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 52rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.profile-name {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
  margin-top: 16rpx;
}

.profile-role {
  font-size: 24rpx;
  color: var(--muted, #6F675D);
  margin-top: 6rpx;
}

.info-card,
.stats-card,
.overview-card,
.recent-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--border, #EDE5DA);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: var(--muted, #6F675D);
}

.info-value {
  font-size: 28rpx;
  color: var(--fg, #2E2A25);
  font-weight: 500;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--accent-deep, #A64E1D);
  font-variant-numeric: tabular-nums;
}

.stat-label {
  font-size: 22rpx;
  color: var(--faint, #9B9084);
  margin-top: 6rpx;
}

.overview-row {
  display: flex;
  justify-content: space-around;
  margin-top: 16rpx;
}

.overview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.overview-number {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
  font-variant-numeric: tabular-nums;
}

.overview-label {
  font-size: 22rpx;
  color: var(--faint, #9B9084);
  margin-top: 4rpx;
}

.lesson-item {
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--border, #EDE5DA);
}

.lesson-item:last-child {
  border-bottom: none;
}

.lesson-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.lesson-class {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--fg, #2E2A25);
}

.lesson-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.status-PLANNED { background-color: var(--accent-soft, #FBEEE2); color: var(--accent-deep, #A64E1D); }
.status-TEACHING { background: var(--growth-soft, #EAF1EC); color: var(--growth-deep, #3E5B4A); }
.status-COMPLETED { background: #F1EDE6; color: var(--muted, #6F675D); }
.status-CANCELLED { background: var(--danger-soft, #F9E9E7); color: var(--danger, #C4483F); }

.lesson-info {
  margin-top: 6rpx;
}

.lesson-topic {
  display: block;
  font-size: 25rpx;
  color: var(--muted, #6F675D);
}

.lesson-date {
  display: block;
  font-size: 22rpx;
  color: var(--faint, #9B9084);
  margin-top: 4rpx;
}

.quick-nav {
  display: flex;
  gap: 20rpx;
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: var(--shadow-sm);
}

.ni {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background-color: var(--accent-soft, #FBEEE2);
  margin-bottom: 10rpx;
}

.nav-text {
  font-size: 23rpx;
  color: var(--muted, #6F675D);
}

.logout-section {
  margin-top: 8rpx;
}

.logout-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 3rpx solid var(--danger, #C4483F);
  color: var(--danger, #C4483F);
  font-size: 30rpx;
  font-weight: 600;
}

.logout-btn::after {
  border: none;
}
