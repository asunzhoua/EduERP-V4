/* pages/student/leave-apply/leave-apply.wxss · 暖杏奶油 */
.container {
  padding: 24rpx;
  background: var(--bg, #FAF6F0);
  min-height: 100vh;
  box-sizing: border-box;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid var(--accent-soft, #FBEEE2);
  border-top-color: var(--accent, #D97B3E);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: var(--faint, #9B9084);
}

.form-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 12rpx 28rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--border, #EDE5DA);
}

.form-block {
  padding-top: 28rpx;
}

.lab {
  font-size: 29rpx;
  color: var(--fg, #2E2A25);
  font-weight: 600;
}

.req {
  color: var(--danger, #C4483F);
}

.hint {
  font-size: 23rpx;
  color: var(--faint, #9B9084);
  font-weight: 400;
}

.val {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--fg, #2E2A25);
}

.val.ph {
  color: var(--faint, #9B9084);
}

.val .ic-chevron {
  width: 30rpx;
  height: 30rpx;
  margin-left: 8rpx;
}

.chips {
  display: flex;
  gap: 16rpx;
}

.remark {
  width: 100%;
  height: 160rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--border, #EDE5DA);
  border-radius: 20rpx;
  background: #FFFFFF;
  padding: 20rpx;
  font-size: 28rpx;
  color: var(--fg, #2E2A25);
  margin-top: 16rpx;
}

.remark:focus {
  border-color: var(--accent, #D97B3E);
  box-shadow: 0 0 0 6rpx rgba(217,123,62,.12);
}

.ph {
  color: var(--faint, #9B9084);
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: var(--faint, #9B9084);
  margin-top: 8rpx;
}

/* 附件 */
.upload-area {
  margin-top: 16rpx;
}

.file-list {
  margin-bottom: 16rpx;
}

.file-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--accent-soft, #FBEEE2);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}

.file-name {
  flex: 1;
  font-size: 25rpx;
  color: var(--accent-deep, #A64E1D);
}

.file-remove {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.file-remove .ic-close {
  width: 30rpx;
  height: 30rpx;
}

.upload-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  border: 3rpx dashed var(--accent, #D97B3E);
  border-radius: 20rpx;
  color: var(--accent-deep, #A64E1D);
  font-size: 27rpx;
  font-weight: 600;
}

.upload-btn .ic-add {
  width: 40rpx;
  height: 40rpx;
}

/* 提交 */
.submit-btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 999rpx;
  background: var(--accent-deep, #A64E1D);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  border: none;
  box-shadow: 0 12rpx 32rpx rgba(166,78,29,.28);
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background: #D8CFC2;
  box-shadow: none;
}

.form-note {
  text-align: center;
  font-size: 23rpx;
  color: var(--faint, #9B9084);
  margin-top: 20rpx;
}
