/* pages/student/feedback/feedback.wxss · 暖杏奶油 · 成长手记 */
.container {
  padding: 24rpx;
  background: var(--bg, #FAF6F0);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 引言 */
.fb-intro {
  background: linear-gradient(160deg, #FBE6CF, #FAF6F0);
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 28rpx;
  text-align: center;
}

.fb-intro .t {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--fg, #2E2A25);
}

.fb-intro .s {
  font-size: 24rpx;
  color: var(--muted, #6F675D);
  margin-top: 10rpx;
}

/* 反馈列表 */
.feedback-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.fb-card {
  background: #FFFFFF;
  border-radius: 40rpx;
  padding: 40rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
}

/* 顶部：头像 + 课程 + 日期 */
.fb-top {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.fb-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8A25E, #A64E1D);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 700;
  flex: none;
}

.fb-meta {
  flex: 1;
  min-width: 0;
}

.fb-course {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
}

.fb-date {
  font-size: 24rpx;
  color: var(--faint, #9B9084);
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
}

.fb-content {
  background: linear-gradient(160deg, #FBEEE2, #FAF6F0);
  border-radius: 36rpx;
  padding: 40rpx 44rpx;
}

.fb-content-label {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--accent-deep, #A64E1D);
  margin-bottom: 20rpx;
}

.fb-content-label .ic {
  width: 36rpx;
  height: 36rpx;
}

.fb-content-text {
  font-size: 32rpx;
  line-height: 1.9;
  color: var(--fg, #2E2A25);
}
