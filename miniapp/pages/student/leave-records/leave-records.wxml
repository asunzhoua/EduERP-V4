<view class="container">
  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 错误状态 -->
  <view class="error-state" wx:elif="{{error}}">
    <text class="error-text">{{error}}</text>
    <view class="retry-btn" bindtap="loadRecords">点击重试</view>
  </view>

  <!-- 列表内容 -->
  <block wx:else>
    <!-- 状态过滤 -->
    <view class="filter-bar">
      <view class="filter-item {{filterStatus === '' ? 'filter-active' : ''}}" bindtap="onFilter" data-status="">
        <text class="filter-text">全部</text>
      </view>
      <view class="filter-item {{filterStatus === 'PENDING' ? 'filter-active' : ''}}" bindtap="onFilter" data-status="PENDING">
        <text class="filter-text">待审批</text>
      </view>
      <view class="filter-item {{filterStatus === 'APPROVED' ? 'filter-active' : ''}}" bindtap="onFilter" data-status="APPROVED">
        <text class="filter-text">已通过</text>
      </view>
      <view class="filter-item {{filterStatus === 'REJECTED' ? 'filter-active' : ''}}" bindtap="onFilter" data-status="REJECTED">
        <text class="filter-text">已拒绝</text>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{records.length === 0}}">
      <text class="empty-icon">📋</text>
      <text class="empty-text">暂无申请记录</text>
    </view>

    <!-- 申请列表 -->
    <view class="record-list" wx:else>
      <view class="record-card" wx:for="{{records}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
        <view class="record-header">
          <text class="record-type">{{item.typeText}}</text>
          <text class="record-status status-{{item.status}}">{{item.statusText}}</text>
        </view>
        <view class="record-body">
          <view class="record-row">
            <text class="record-label">课程</text>
            <text class="record-value">{{item.courseName || '--'}}</text>
          </view>
          <view class="record-row">
            <text class="record-label">日期</text>
            <text class="record-value">{{item.date || '--'}}</text>
          </view>
          <view class="record-row">
            <text class="record-label">原因</text>
            <text class="record-value reason">{{item.reason || '--'}}</text>
          </view>
        </view>
        <view class="record-footer">
          <text class="record-time">{{item.createdAt || '--'}}</text>
          <text class="record-arrow">></text>
        </view>
      </view>
    </view>
  </block>
</view>
