/* pages/forgot-password/forgot-password.wxss · 暖杏奶油 */
.auth-page {
  min-height: 100vh;
  padding: 40rpx 44rpx;
  background: var(--bg, #FAF6F0);
  box-sizing: border-box;
}

.auth-sub {
  text-align: center;
  font-size: 26rpx;
  color: var(--muted, #6F675D);
  padding: 10rpx 0 28rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 48rpx 32rpx 36rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.guide-ic {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--accent-soft, #FBEEE2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 22rpx;
}

.guide-ic .ic {
  width: 50rpx;
  height: 50rpx;
}

.guide-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
  margin-bottom: 26rpx;
}

.guide-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  padding: 20rpx 22rpx;
  background: var(--bg, #FAF6F0);
  border-radius: 16rpx;
  margin-bottom: 14rpx;
  font-size: 28rpx;
  color: var(--fg, #2E2A25);
}

.guide-item .ic {
  width: 36rpx;
  height: 36rpx;
}

.guide-note {
  font-size: 24rpx;
  color: var(--faint, #9B9084);
  text-align: center;
  margin-top: 10rpx;
  line-height: 1.7;
}

.link {
  color: var(--accent-deep, #A64E1D);
}

.btn-primary-full {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 999rpx;
  background: #A64E1D;
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  border: none;
  box-shadow: 0 12rpx 32rpx rgba(166,78,29,.28);
  margin-top: 28rpx;
}

.btn-primary-full::after {
  border: none;
}

.auth-link {
  text-align: center;
  font-size: 26rpx;
  color: var(--muted, #6F675D);
  margin-top: 28rpx;
}
