<!-- pages/forgot-password/forgot-password.wxml -->
<view class="auth-page">
  <view class="auth-sub">为保障账号安全，密码重置需由机构核实身份后办理</view>

  <view class="card">
    <view class="guide-ic"><view class="ic ic-shield"></view></view>
    <view class="guide-title">请通过以下方式联系机构</view>

    <view class="guide-item">
      <view class="ic ic-phone"></view>
      <text>拨打机构前台电话</text>
    </view>
    <view class="guide-item">
      <view class="ic ic-contact"></view>
      <text>在小程序「我的-联系客服」留言</text>
    </view>

    <view class="guide-note">机构核实家长身份后，将为你重置登录密码并告知。</view>
  </view>

  <button class="btn-primary-full" bindtap="goContact">联系机构</button>

  <view class="auth-link">想起密码了？<text class="link" bindtap="goBack">返回登录</text></view>
</view>
