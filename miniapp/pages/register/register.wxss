/* pages/register/register.wxss · 暖杏奶油 */
.auth-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #FAF6F0;
}

.auth-sub {
  text-align: center;
  font-size: 26rpx;
  color: var(--muted, #6F675D);
  padding: 20rpx 52rpx 8rpx;
}

.auth-form {
  padding: 20rpx 52rpx 40rpx;
  display: flex;
  flex-direction: column;
}

.field {
  position: relative;
  margin-bottom: 24rpx;
}

.fic {
  position: absolute;
  left: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 34rpx;
  height: 34rpx;
  opacity: .85;
}

.input {
  width: 100%;
  height: 100rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--border, #EDE5DA);
  background: #FFFFFF;
  padding: 0 92rpx;
  font-size: 30rpx;
  color: var(--fg, #2E2A25);
  box-sizing: border-box;
}

.input:focus {
  border-color: var(--accent, #D97B3E);
  box-shadow: 0 0 0 6rpx rgba(217,123,62,.14);
}

.ph {
  color: var(--faint, #9B9084);
}

.agree {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--muted, #6F675D);
  margin: 4rpx 0 20rpx;
}

.cb {
  width: 32rpx;
  height: 32rpx;
  border-radius: 10rpx;
  border: 3rpx solid var(--accent, #D97B3E);
  background: var(--accent, #D97B3E);
  margin-right: 12rpx;
  position: relative;
  box-sizing: border-box;
}

.cb::after {
  content: "";
  position: absolute;
  left: 9rpx;
  top: 3rpx;
  width: 8rpx;
  height: 16rpx;
  border: solid #FFFFFF;
  border-width: 0 4rpx 4rpx 0;
  transform: rotate(45deg);
}

.link {
  color: var(--accent-deep, #A64E1D);
}

.btn-primary-full {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 999rpx;
  background: #A64E1D;
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  border: none;
  box-shadow: 0 12rpx 32rpx rgba(166,78,29,.28);
}

.btn-primary-full::after {
  border: none;
}

.btn-primary-full[disabled] {
  background: #D8CFC2;
  box-shadow: none;
}

.auth-link {
  text-align: center;
  font-size: 26rpx;
  color: var(--muted, #6F675D);
  margin-top: 24rpx;
}
