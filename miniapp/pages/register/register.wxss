/* pages/register/register.wxss */
.register-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 60rpx;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  min-height: 100vh;
}

.register-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.register-form {
  width: 100%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 50rpx 40rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.register-btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background: #1890ff;
  color: #ffffff;
  font-size: 34rpx;
  border-radius: 12rpx;
  margin-top: 40rpx;
}

.login-link {
  text-align: center;
  color: #1890ff;
  font-size: 28rpx;
  margin-top: 30rpx;
}
