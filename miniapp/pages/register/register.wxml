<!--pages/register/register.wxml-->
<view class="auth-page">
  <view class="auth-sub">教师 / 家长自助注册，无需短信验证</view>

  <view class="auth-form">
    <view class="role-select">
      <view class="role-card {{role === 'Teacher' ? 'active' : ''}}" bindtap="onSelectRole" data-role="Teacher">
        <view class="role-title">我是老师</view>
        <view class="role-sub">教师账号自助注册</view>
      </view>
      <view class="role-card {{role === 'Parent' ? 'active' : ''}}" bindtap="onSelectRole" data-role="Parent">
        <view class="role-title">我是家长</view>
        <view class="role-sub">家长账号自助注册</view>
      </view>
    </view>

    <view class="field">
      <view class="fic ic ic-user"></view>
      <input class="input" placeholder="请输入用户名" placeholder-class="ph"
        value="{{username}}" data-field="username" bindinput="onInput" />
    </view>
    <view class="field">
      <view class="fic ic ic-idcard"></view>
      <input class="input" placeholder="请输入姓名" placeholder-class="ph"
        value="{{name}}" data-field="name" bindinput="onInput" />
    </view>
    <view class="field">
      <view class="fic ic ic-phone"></view>
      <input class="input" type="number" placeholder="请输入手机号" placeholder-class="ph"
        value="{{mobile}}" data-field="mobile" bindinput="onInput" />
    </view>
    <view class="field">
      <view class="fic ic ic-lock"></view>
      <input class="input" password placeholder="请输入密码（至少 6 位）" placeholder-class="ph"
        value="{{password}}" data-field="password" bindinput="onInput" />
    </view>
    <view class="field">
      <view class="fic ic ic-lock"></view>
      <input class="input" password placeholder="请再次输入密码" placeholder-class="ph"
        value="{{confirmPassword}}" data-field="confirmPassword" bindinput="onInput" />
    </view>

    <view class="agree">
      <view class="cb on"></view>
      <text>已阅读并同意</text><text class="link" catchtap="goToAgreement" data-type="user">《用户协议》</text><text>与</text><text class="link" catchtap="goToAgreement" data-type="privacy">《隐私政策》</text>
    </view>

    <button class="btn-primary-full" bindtap="onRegister" loading="{{loading}}">注　册</button>

    <view class="auth-link">已有账号？<text class="link" bindtap="goToLogin">返回登录</text></view>
  </view>
</view>
