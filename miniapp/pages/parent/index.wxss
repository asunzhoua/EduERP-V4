/* pages/parent/index.wxss */
.container {
  padding: 20rpx;
  min-height: 100vh;
  background-color: #FAF6F0;
}

.loading, .error, .empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #9B9084;
}

.retry-btn {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #D97B3E;
}

.children-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.child-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(59,157,255,0.08));
}

.child-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.child-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #2E2A25;
}

.child-code {
  font-size: 24rpx;
  color: #9B9084;
}

.child-status .status-text {
  font-size: 24rpx;
  color: #D97B3E;
  background: #FBEEE2;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}
