/* pages/parent/child-detail.wxss */
.container {
  padding: 20rpx;
  min-height: 100vh;
  background-color: #FAF6F0;
}

.loading, .error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #9B9084;
}

.retry-btn {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #D97B3E;
}

.info-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.child-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #2E2A25;
}

.child-code, .child-school, .child-grade {
  font-size: 26rpx;
  color: #6F675D;
}

/* 切换孩子入口（多子家长跳转 parent/index 全量列表） */
.switch-child-btn {
  align-self: flex-start;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #A64E1D;
  padding: 8rpx 24rpx;
  border: 1rpx solid #F0D9B8;
  border-radius: 999rpx;
  background: #FCF0DE;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #6F675D;
  border-bottom: 4rpx solid transparent;
}

.tab.active {
  color: #D97B3E;
  border-bottom-color: #D97B3E;
}

.tab-content {
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  padding: 40rpx 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 600;
  color: #D97B3E;
}

.stat-label {
  font-size: 24rpx;
  color: #9B9084;
}

.empty-tab {
  text-align: center;
  padding: 60rpx 0;
  color: #9B9084;
  font-size: 28rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #FAF6F0;
  border-radius: 16rpx;
}

.item-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.item-title {
  font-size: 28rpx;
  color: #2E2A25;
}

.item-sub {
  font-size: 24rpx;
  color: #9B9084;
}

.item-detail {
  font-size: 24rpx;
  color: #A64E1D;
}

.item-status text {
  font-size: 24rpx;
  color: #D97B3E;
}

.status-PRESENT { color: #D97B3E; }
.status-LATE { color: #D98E2B; }
.status-ABSENT { color: #C4483F; }
.status-LEAVE { color: #D97B3E; }

/* 剩余课时预警徽标 */
.warning-badge {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

.warning-warn {
  color: #B9761B;
  background: #FCF0DE;
}

.warning-critical {
  color: #fff;
  background: #C4483F;
}

/* 课时不足预警横幅 */
.warn-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: #FCF0DE;
  border: 1rpx solid #F0D9B8;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.warn-banner-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
}

.warn-banner-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #B9761B;
}

.warn-banner-desc {
  font-size: 22rpx;
  color: #8A6A3A;
}

.warn-banner-action {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #fff;
  background: #C4483F;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
}
