/* pages/parent/child-detail.wxss */
.container {
  padding: 20rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.loading, .error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #999;
}

.retry-btn {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #1890ff;
}

.info-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.child-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.child-code, .child-school, .child-grade {
  font-size: 26rpx;
  color: #666;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
}

.tab.active {
  color: #1890ff;
  border-bottom-color: #1890ff;
}

.tab-content {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  padding: 40rpx 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 600;
  color: #1890ff;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.empty-tab {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #fafafa;
  border-radius: 8rpx;
}

.item-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-title {
  font-size: 28rpx;
  color: #333;
}

.item-sub {
  font-size: 24rpx;
  color: #999;
}

.item-status text {
  font-size: 24rpx;
  color: #52c41a;
}

.status-PRESENT { color: #52c41a; }
.status-LATE { color: #faad14; }
.status-ABSENT { color: #ff4d4f; }
.status-LEAVE { color: #1890ff; }
