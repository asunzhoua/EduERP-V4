/* pages/index/index.wxss · 暖杏奶油 */
.container {
  padding: 24rpx;
  background: var(--bg, #FAF6F0);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ============ 家长/学生首页 ============ */
.home-header {
  margin: -24rpx -24rpx 20rpx;
  padding: 32rpx 32rpx 28rpx;
  background: var(--gradient-header, linear-gradient(160deg, #FBE6CF, #FAF6F0));
  border-radius: 0 0 32rpx 32rpx;
}

.greet {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.greet-hi {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
}

.greet-sub {
  font-size: 24rpx;
  color: var(--muted, #6F675D);
  margin-top: 6rpx;
}

.profile-mini {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-mini .ic {
  width: 40rpx;
  height: 40rpx;
}

/* 顶部操作区（消息铃铛 + 头像） */
.header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.bell-mini {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}

.bell-mini .ic {
  width: 40rpx;
  height: 40rpx;
}

.bell-badge {
  position: absolute;
  top: -4rpx;
  right: -6rpx;
  min-width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--danger, #C4483F);
  color: #FFFFFF;
  font-size: 20rpx;
  text-align: center;
  box-sizing: border-box;
}

/* 我的积分迷你卡 */
.points-mini .points-mini-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 6rpx;
}

.points-mini-balance {
  font-size: 64rpx;
  font-weight: 800;
  color: var(--accent-deep, #A64E1D);
  font-variant-numeric: tabular-nums;
}

.points-mini-unit {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--muted, #6F675D);
  margin-left: 6rpx;
}

.points-mini-action {
  font-size: 24rpx;
  color: var(--muted, #6F675D);
  padding-bottom: 8rpx;
}

/* 最近课程反馈 */
.fb-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--border, #EDE5DA);
}

.fb-row:last-child {
  border-bottom: none;
}

.fb-mid {
  flex: 1;
  min-width: 0;
}

.fb-s {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--fg, #2E2A25);
}

.fb-date {
  font-size: 23rpx;
  font-weight: 400;
  color: var(--faint, #9B9084);
  margin-left: 8rpx;
}

.fb-t {
  font-size: 23rpx;
  color: var(--muted, #6F675D);
  margin-top: 4rpx;
}

.fb-badge {
  flex: none;
  margin-left: 20rpx;
  font-size: 24rpx;
  color: var(--accent-deep, #A64E1D);
}

.child-switcher {
  white-space: nowrap;
  margin-top: 24rpx;
}

.child-chip {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  background: #FFFFFF;
  color: var(--muted, #6F675D);
  border: 2rpx solid var(--border, #EDE5DA);
  margin-right: 16rpx;
}

.child-chip:first-child {
  background: var(--accent-deep, #A64E1D);
  color: #FFFFFF;
  border-color: var(--accent-deep, #A64E1D);
}

/* 余额大卡 */
.balance-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-md, 0 8rpx 24rpx rgba(120,80,40,.12));
}

.balance-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.balance-label {
  font-size: 26rpx;
  color: var(--muted, #6F675D);
}

.balance-num {
  margin-top: 4rpx;
  font-size: 92rpx;
  font-weight: 800;
  line-height: 1.05;
  color: var(--fg, #2E2A25);
  font-variant-numeric: tabular-nums;
}

.balance-num .unit {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--muted, #6F675D);
  margin-left: 6rpx;
}

.balance-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--faint, #9B9084);
}

.balance-pct {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--accent-deep, #A64E1D);
}

.balance-card .progress-track {
  margin-top: 24rpx;
}

.low-banner {
  margin-top: 20rpx;
  background: var(--warning-soft, #FCF0DF);
  border: 2rpx solid #EFD9B8;
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  font-size: 25rpx;
  color: var(--accent-deep, #A64E1D);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.low-btn {
  font-size: 24rpx;
  color: #FFFFFF;
  background: var(--accent-deep, #A64E1D);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  font-weight: 600;
}

/* 卡片通用 */
.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
}

.link {
  font-size: 24rpx;
  color: var(--muted, #6F675D);
}

/* 今日课程 */
.class-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--border, #EDE5DA);
}

.class-item:last-child {
  border-bottom: none;
}

.class-time {
  flex: none;
  width: 96rpx;
  text-align: center;
}

.class-time .t {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
  font-variant-numeric: tabular-nums;
}

.class-time .d {
  font-size: 20rpx;
  color: var(--faint, #9B9084);
}

.class-mid {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.class-mid .s {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--fg, #2E2A25);
}

.class-mid .t {
  font-size: 23rpx;
  color: var(--muted, #6F675D);
  margin-top: 4rpx;
}

.class-item.past .class-time .t,
.class-item.past .class-mid .s {
  color: var(--faint, #9B9084);
}

/* 出勤概览 */
.att-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--border, #EDE5DA);
  font-size: 27rpx;
  color: var(--fg, #2E2A25);
}

.att-row:last-child {
  border-bottom: none;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 18rpx;
  flex: none;
}

.dot.g { background: var(--growth, #5B7A66); }
.dot.r { background: var(--danger, #C4483F); }
.dot.y { background: #D9A441; }

.att-status {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--muted, #6F675D);
}

/* ============ 教师/管理员仪表盘 ============ */
.user-card {
  display: flex;
  align-items: center;
  padding: 36rpx;
  background: var(--gradient-header, linear-gradient(160deg, #FBE6CF, #FAF6F0));
  border-radius: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,.6);
  background: rgba(255,255,255,.4);
}

.user-info {
  margin-left: 26rpx;
}

.user-name {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
}

.user-role {
  display: block;
  font-size: 24rpx;
  color: var(--muted, #6F675D);
  margin-top: 8rpx;
}

.quick-actions {
  margin-bottom: 24rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: var(--shadow-sm);
}

.ai {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background-color: var(--accent-soft, #FBEEE2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.ai .ic {
  width: 40rpx;
  height: 40rpx;
}

.action-text {
  font-size: 24rpx;
  color: var(--muted, #6F675D);
  font-weight: 500;
}

.section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
}

.section-refresh {
  font-size: 24rpx;
  color: var(--accent-deep, #A64E1D);
}

.overview-card {
  display: flex;
  justify-content: space-around;
  padding: 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: var(--shadow-sm);
}

.overview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.overview-value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--accent-deep, #A64E1D);
  font-variant-numeric: tabular-nums;
}

.overview-label {
  font-size: 24rpx;
  color: var(--faint, #9B9084);
  margin-top: 8rpx;
}

.overview-value.has-data {
  color: var(--growth, #5B7A66);
}

.overview-value.warning {
  color: var(--warning, #D98E2B);
}

.error-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.error-hint {
  font-size: 24rpx;
  color: var(--accent-deep, #A64E1D);
  margin-top: 8rpx;
}

/* 提示卡片 */
.tips-card {
  margin-top: 20rpx;
  padding: 20rpx 26rpx;
  background: var(--warning-soft, #FCF0DF);
  border-radius: 16rpx;
}

.tips-content {
  display: flex;
  align-items: center;
}

.tips-content .ic {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
}

.tips-text {
  font-size: 26rpx;
  color: #7C5A12;
}
