/* pages/teacher/student-detail/index.wxss */
.container {
  padding: 20rpx;
  background: #FAF6F0;
  min-height: 100vh;
}

/* 加载/错误状态 */
.loading-state, .error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #FBEEE2;
  border-top-color: #D97B3E;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #9B9084;
  margin-top: 16rpx;
}

.error-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.error-text {
  font-size: 28rpx;
  color: #9B9084;
  margin-bottom: 20rpx;
}

.retry-btn {
  padding: 16rpx 40rpx;
  background: #D97B3E;
  color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
}

/* 个人信息卡片 */
.profile-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #D97B3E 0%, #A64E1D 100%);
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  color: #fff;
}

.profile-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.profile-info {
  flex: 1;
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: bold;
}

.profile-gender {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  padding: 2rpx 12rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
}

.profile-school {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 信息区块 */
.info-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #2E2A25;
  margin-bottom: 16rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: #6F675D;
}

.info-value {
  font-size: 26rpx;
  color: #2E2A25;
  font-weight: 500;
}

/* 班级区块 */
.class-section {
  margin-bottom: 20rpx;
}

.section-header {
  padding: 0 0 16rpx 0;
}

.class-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.class-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
}

.class-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.class-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #2E2A25;
}

.class-code {
  font-size: 22rpx;
  color: #9B9084;
}

.class-mid {
  margin-bottom: 12rpx;
}

.class-course {
  font-size: 26rpx;
  color: #6F675D;
}

.class-progress {
  display: flex;
  align-items: center;
}

.progress-bar {
  flex: 1;
  height: 16rpx;
  background: #FAF6F0;
  border-radius: 16rpx;
  overflow: hidden;
  margin-right: 16rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #D97B3E, #D97B3E);
  border-radius: 16rpx;
}

.progress-text {
  font-size: 22rpx;
  color: #9B9084;
  white-space: nowrap;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 60rpx 0;
  color: #9B9084;
  font-size: 26rpx;
}

/* 操作区域 */
.action-section {
  padding: 10rpx 0 40rpx;
}

.action-btn {
  width: 100%;
  padding: 24rpx;
  background: #D97B3E;
  color: #fff;
  border-radius: 24rpx;
  font-size: 30rpx;
  text-align: center;
}

/* 统计摘要卡片 */
.stats-card {
  margin: 20rpx 0;
  padding: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(59,157,255,0.08));
}
.stats-row {
  display: flex;
  justify-content: space-around;
}
.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stats-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #D97B3E;
}
.stats-label {
  font-size: 24rpx;
  color: #9B9084;
  margin-top: 8rpx;
}

/* 课时余额（合同同源） */
.contract-section {
  margin-bottom: 20rpx;
}

.contract-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.contract-summary {
  font-size: 24rpx;
  color: #A64E1D;
  font-weight: 600;
}

.contract-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.contract-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
}

.contract-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.contract-subject {
  font-size: 28rpx;
  font-weight: bold;
  color: #2E2A25;
}

.contract-status {
  font-size: 22rpx;
  color: #A64E1D;
  padding: 2rpx 14rpx;
  background: #FBEEE2;
  border-radius: 999rpx;
}

.contract-nums {
  display: flex;
  gap: 32rpx;
}

.contract-num {
  font-size: 24rpx;
  color: #6F675D;
  font-variant-numeric: tabular-nums;
}

.contract-remain {
  color: #A64E1D;
  font-weight: 600;
}
