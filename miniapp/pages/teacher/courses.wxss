/* pages/teacher/courses.wxss · 暖杏奶油 */
.container {
  padding: 20rpx;
  background: var(--bg, #FAF6F0);
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 150rpx;
}

/* 搜索栏 */
.search-bar {
  margin-bottom: 20rpx;
}

.search-wrapper {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 0 20rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
  border: 2rpx solid var(--border, #EDE5DA);
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  height: 84rpx;
  font-size: 28rpx;
  color: var(--fg, #2E2A25);
}

.clear-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--faint, #9B9084);
}

.clear-btn .ic-close {
  width: 34rpx;
  height: 34rpx;
}

.stats-bar {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.stats-text {
  font-size: 24rpx;
  color: var(--muted, #6F675D);
}

.course-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.course-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}

.course-card:active {
  transform: scale(0.98);
}

.course-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.course-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
  display: block;
}

.course-status {
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}

.status-PUBLISHED {
  background: var(--growth-soft, #EAF1EC);
  color: var(--growth-deep, #3E5B4A);
}

.status-DRAFT {
  background: var(--warning-soft, #FCF0DF);
  color: #A86A17;
}

.status-ARCHIVED {
  background: #F1EDE6;
  color: var(--muted, #6F675D);
}

.course-info {
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.info-label {
  font-size: 24rpx;
  color: var(--faint, #9B9084);
  width: 80rpx;
}

.info-value {
  font-size: 26rpx;
  color: var(--muted, #6F675D);
}

.course-meta {
  display: flex;
  gap: 40rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--border, #EDE5DA);
}

.meta-item {
  display: flex;
  flex-direction: column;
}

.meta-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--accent-deep, #A64E1D);
}

.meta-label {
  font-size: 22rpx;
  color: var(--faint, #9B9084);
  margin-top: 4rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--accent-soft, #FBEEE2);
  border-top-color: var(--accent, #D97B3E);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: var(--faint, #9B9084);
  margin-top: 16rpx;
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.error-icon {
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.error-text {
  font-size: 28rpx;
  color: var(--muted, #6F675D);
}

.retry-btn {
  font-size: 28rpx;
  color: var(--accent-deep, #A64E1D);
  margin-top: 20rpx;
  padding: 10rpx 30rpx;
  border: 2rpx solid var(--accent, #D97B3E);
  border-radius: 16rpx;
}

.load-more,
.no-more {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: var(--faint, #9B9084);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--faint, #9B9084);
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--accent-deep, #A64E1D);
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--accent-deep, #A64E1D);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 40rpx rgba(166,78,29,.3);
  z-index: 100;
}

.fab-icon {
  font-size: 64rpx;
  font-weight: 300;
  line-height: 1;
}

/* ===== 家长/学生视图：孩子课程 ===== */
.student-view .error-card {
  background: var(--danger-soft, #F9E9E7);
  border-radius: 28rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.student-view .retry-btn {
  font-size: 28rpx;
  color: var(--accent-deep, #A64E1D);
  margin-top: 16rpx;
}

.course-item {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}

.course-item:active {
  transform: scale(0.99);
}

.ci-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ci-subject {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
}

.ci-remain {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--accent-deep, #A64E1D);
  font-variant-numeric: tabular-nums;
}

.ci-unit {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--muted, #6F675D);
  margin-left: 6rpx;
}

.ci-meta {
  font-size: 23rpx;
  color: var(--faint, #9B9084);
  margin-top: 4rpx;
}

.course-item .progress-track {
  margin-top: 18rpx;
}

.ci-foot {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--muted, #6F675D);
  margin-top: 14rpx;
}
