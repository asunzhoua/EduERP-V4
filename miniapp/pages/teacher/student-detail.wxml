<!--pages/teacher/student-detail/index.wxml-->
<view class="container">
  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 错误状态 -->
  <view class="error-state" wx:elif="{{error}}">
    <view class="ic ic-warn error-ic"></view>
    <text class="error-text">{{error}}</text>
    <button class="retry-btn" bindtap="retryLoad">重试</button>
  </view>

  <block wx:else>
    <!-- 个人信息卡片 -->
    <view class="profile-card">
      <view class="profile-avatar">
        <image src="/images/default-avatar.png" mode="aspectFill" class="avatar-img"></image>
      </view>
      <view class="profile-info">
        <view class="profile-header">
          <text class="profile-name">{{student.name}}</text>
          <text class="profile-gender">{{student.gender === 'MALE' ? '男' : student.gender === 'FEMALE' ? '女' : student.gender}}</text>
        </view>
        <view class="profile-school">
          <text>{{student.school}} · {{student.grade}}</text>
        </view>
      </view>
    </view>

    <!-- 学习统计摘要 -->
    <view class="stats-card" wx:if="{{classes.length > 0}}">
      <view class="stats-row">
        <view class="stats-item">
          <text class="stats-value">{{classes.length}}</text>
          <text class="stats-label">在读班级</text>
        </view>
        <view class="stats-item">
          <text class="stats-value">{{totalCompletedLessons}}</text>
          <text class="stats-label">已完成课时</text>
        </view>
        <view class="stats-item">
          <text class="stats-value">{{overallProgress}}%</text>
          <text class="stats-label">总体进度</text>
        </view>
      </view>
    </view>

    <!-- 课时余额（与家长/学生/后台同源：合同剩余课时） -->
    <view class="contract-section" wx:if="{{contracts.length > 0}}">
      <view class="section-header contract-header">
        <text class="section-title">课时余额</text>
        <text class="contract-summary">剩余 {{contractSummary.remaining}} / 共 {{contractSummary.total}} 节</text>
      </view>
      <view class="contract-list">
        <view class="contract-card" wx:for="{{contracts}}" wx:key="contractCode">
          <view class="contract-top">
            <text class="contract-subject">{{item.subject}}</text>
            <text class="contract-status">{{item.statusText}}</text>
          </view>
          <view class="contract-nums">
            <text class="contract-num">总 {{item.totalLessons}} 节</text>
            <text class="contract-num contract-remain">剩余 {{item.remainingLessons}} 节</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 联系方式 -->
    <view class="info-section">
      <view class="section-title">联系方式</view>
      <view class="info-item">
        <text class="info-label">电话</text>
        <text class="info-value">{{student.phone || '未填写'}}</text>
      </view>
    </view>

    <!-- 所属班级 -->
    <view class="class-section">
      <view class="section-header">
        <text class="section-title">所属班级</text>
      </view>

      <view class="class-list">
        <view
          class="class-card"
          wx:for="{{classes}}"
          wx:key="classCode"
          bindtap="goToClassDetail"
          data-code="{{item.classCode}}"
        >
          <view class="class-top">
            <text class="class-name">{{item.name || item.courseName}}</text>
            <text class="class-code">{{item.classCode}}</text>
          </view>
          <view class="class-mid">
            <text class="class-course">{{item.courseName}}</text>
          </view>
          <view class="class-progress">
            <view class="progress-bar">
              <view class="progress-fill" style="width: {{item.totalLessons > 0 ? (item.completedLessons / item.totalLessons * 100) : 0}}%"></view>
            </view>
            <text class="progress-text">{{item.completedLessons || 0}}/{{item.totalLessons || 0}}</text>
          </view>
        </view>
      </view>

      <view class="empty" wx:if="{{classes.length === 0}}">
        <text>暂无班级信息</text>
      </view>
    </view>

    <!-- 出勤记录按钮 -->
    <view class="action-section">
      <button class="action-btn" bindtap="goToLessonRecord">查看出勤记录</button>
    </view>
  </block>
</view>
