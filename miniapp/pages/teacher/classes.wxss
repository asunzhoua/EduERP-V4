/* pages/teacher/classes.wxss · 暖杏奶油 */
.container {
  padding: 20rpx;
  background: var(--bg, #FAF6F0);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0;
  margin-bottom: 16rpx;
}

.filter-item {
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  color: var(--muted, #6F675D);
  background: #ffffff;
  border-radius: 40rpx;
}

.filter-item.active {
  color: #ffffff;
  background: var(--accent-deep, #A64E1D);
  box-shadow: 0 8rpx 24rpx rgba(166,78,29,.2);
}

/* 班级列表 */
.class-list {
  margin-top: 20rpx;
}

.class-card {
  background: #ffffff;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 28rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
}

.class-card:active {
  transform: scale(0.98);
  box-shadow: none;
}

.class-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.class-title {
  flex: 1;
}

.class-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
  display: block;
}

.class-schedule {
  font-size: 24rpx;
  color: var(--accent-deep, #A64E1D);
  margin-top: 8rpx;
  display: block;
}

.class-status {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.status-ACTIVE {
  background: var(--growth-soft, #EAF1EC);
  color: var(--growth-deep, #3E5B4A);
}

.status-DRAFT {
  background: var(--warning-soft, #FCF0DF);
  color: #A86A17;
}

.status-COMPLETED {
  background: #F1EDE6;
  color: var(--muted, #6F675D);
}

.status-CANCELLED {
  background: var(--danger-soft, #F9E9E7);
  color: var(--danger, #C4483F);
}

/* 课程信息 */
.class-info {
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.info-label {
  font-size: 24rpx;
  color: var(--faint, #9B9084);
  width: 80rpx;
}

.info-value {
  font-size: 26rpx;
  color: var(--muted, #6F675D);
}

/* 进度条 */
.progress-section {
  padding: 16rpx 0;
  margin-bottom: 16rpx;
  border-top: 2rpx solid var(--border, #EDE5DA);
}

.progress-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.progress-label {
  font-size: 24rpx;
  color: var(--faint, #9B9084);
}

.progress-text {
  font-size: 24rpx;
  color: var(--accent-deep, #A64E1D);
}

.progress-bar {
  height: 14rpx;
  background: #F1EBE1;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
}

.progress-fill.progress-ACTIVE { background: var(--accent, #D97B3E); }
.progress-fill.progress-DRAFT { background: var(--warning, #D98E2B); }
.progress-fill.progress-COMPLETED { background: var(--growth, #5B7A66); }

.progress-percent {
  font-size: 24rpx;
  color: var(--accent-deep, #A64E1D);
  margin-top: 8rpx;
  display: block;
  text-align: right;
}

/* 底部 */
.class-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--border, #EDE5DA);
}

.student-count {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.count-visual {
  width: 200rpx;
  height: 10rpx;
  background: #F1EBE1;
  border-radius: 999rpx;
  overflow: hidden;
}

.count-bar {
  height: 100%;
  background: var(--accent, #D97B3E);
  border-radius: 999rpx;
}

.count-text {
  font-size: 24rpx;
}

.count-current {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--accent-deep, #A64E1D);
}

.count-sep, .count-max {
  font-size: 24rpx;
  color: var(--faint, #9B9084);
  margin: 0 4rpx;
}

.count-unit {
  font-size: 22rpx;
  color: var(--faint, #9B9084);
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  border: none;
  line-height: 1.4;
}

.action-btn::after {
  border: none;
}

.btn-students {
  background-color: var(--accent-soft, #FBEEE2);
  color: var(--accent-deep, #A64E1D);
}

.btn-record {
  background: var(--accent-deep, #A64E1D);
  color: #ffffff;
}

.btn-record.disabled {
  background: #F1EDE6;
  color: var(--faint, #9B9084);
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--accent-soft, #FBEEE2);
  border-top-color: var(--accent, #D97B3E);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: var(--faint, #9B9084);
  margin-top: 16rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--faint, #9B9084);
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--accent-deep, #A64E1D);
}

/* ===== 家长/学生视图：出勤记录 ===== */
.student-view .error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.student-view .error-text {
  font-size: 28rpx;
  color: var(--faint, #9B9084);
}

.student-view .retry-btn {
  font-size: 28rpx;
  color: var(--accent-deep, #A64E1D);
  margin-top: 20rpx;
  padding: 10rpx 30rpx;
  border: 2rpx solid var(--accent, #D97B3E);
  border-radius: 16rpx;
}

.student-view .stats-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
}

/* 到课率 */
.att-rate {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.att-rate-value {
  font-size: 72rpx;
  font-weight: 800;
  color: var(--growth, #5B7A66);
  font-variant-numeric: tabular-nums;
}

.att-rate-label {
  font-size: 24rpx;
  color: var(--faint, #9B9084);
}

.rate-bar {
  width: 100%;
  height: 14rpx;
  background: #F1EBE1;
  border-radius: 999rpx;
  overflow: hidden;
  margin-top: 16rpx;
}

.rate-fill {
  height: 100%;
  background: var(--growth, #5B7A66);
  border-radius: 999rpx;
}

/* 4 状态 */
.att-grid {
  display: flex;
  justify-content: space-around;
  margin-top: 28rpx;
}

.att-g {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.att-v {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
  font-variant-numeric: tabular-nums;
}

.att-v.present { color: var(--growth, #5B7A66); }
.att-v.absent { color: var(--danger, #C4483F); }
.att-v.late { color: var(--warning, #D98E2B); }
.att-v.leave { color: var(--muted, #6F675D); }

.att-l {
  font-size: 22rpx;
  color: var(--faint, #9B9084);
  margin-top: 4rpx;
}

/* 筛选 */
.student-view .filter-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.student-view .filter-tab {
  padding: 10rpx 24rpx;
  background: #fff;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--muted, #6F675D);
  border: 2rpx solid var(--border, #EDE5DA);
}

.student-view .filter-tab.active {
  background: #fff;
  color: var(--accent-deep, #A64E1D);
  border-color: var(--accent, #D97B3E);
  font-weight: 600;
}

/* 出勤列表 */
.att-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.att-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}

.att-main {
  flex: 1;
}

.att-date {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
  font-variant-numeric: tabular-nums;
}

.att-course {
  font-size: 25rpx;
  color: var(--muted, #6F675D);
  margin-top: 6rpx;
}

.att-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.att-status {
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.att-status.status-PRESENT,
.att-status.status-ONLINE {
  background: var(--growth-soft, #EAF1EC);
  color: var(--growth-deep, #3E5B4A);
}

.att-status.status-ABSENT {
  background: var(--danger-soft, #F9E9E7);
  color: var(--danger, #C4483F);
}

.att-status.status-LATE {
  background: var(--warning-soft, #FCF0DF);
  color: #A86A17;
}

.att-status.status-LEAVE,
.att-status.status-SICK,
.att-status.status-MAKEUP {
  background: #EFEAE3;
  color: var(--muted, #6F675D);
}

.att-status.status-OFFLINE {
  background-color: var(--accent-soft, #FBEEE2);
  color: var(--accent-deep, #A64E1D);
}

.att-status.status-null {
  background: #F1EDE6;
  color: var(--faint, #9B9084);
}

.deduction-skip-badge {
  font-size: 20rpx;
  color: var(--muted, #6F675D);
  margin-top: 6rpx;
}
