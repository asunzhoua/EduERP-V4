<!--pages/teacher/classes.wxml-->
<view class="container">
  <!-- ========== 教师/管理员视图 ========== -->
  <block wx:if="{{!isStudentView}}">
  <!-- 筛选栏 -->
  <view class="filter-bar">
    <view
      class="filter-item {{filter === 'ALL' ? 'active' : ''}}"
      bindtap="onFilterChange"
      data-value="ALL"
    >
      全部
    </view>
    <view
      class="filter-item {{filter === 'ACTIVE' ? 'active' : ''}}"
      bindtap="onFilterChange"
      data-value="ACTIVE"
    >
      进行中
    </view>
    <view
      class="filter-item {{filter === 'COMPLETED' ? 'active' : ''}}"
      bindtap="onFilterChange"
      data-value="COMPLETED"
    >
      已结束
    </view>
  </view>

  <!-- 班级列表 -->
  <view class="class-list">
    <block wx:for="{{classes}}" wx:key="id">
      <view class="class-card" bindtap="goToClassDetail" data-code="{{item.classCode}}">
        <!-- 头部：班级名 + 状态 -->
        <view class="class-header">
          <view class="class-title">
            <text class="class-name">{{item.name}}</text>
            <text class="class-schedule" wx:if="{{item.schedule}}">{{item.schedule}}</text>
          </view>
          <view class="class-status status-{{item.status}}">
            {{item.status === 'ACTIVE' ? '进行中' : item.status === 'COMPLETED' ? '已结束' : item.status === 'DRAFT' ? '草稿' : '已取消'}}
          </view>
        </view>

        <!-- 课程信息 -->
        <view class="class-info">
          <view class="info-row">
            <text class="info-label">课程:</text>
            <text class="info-value">{{item.courseName}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">教室:</text>
            <text class="info-value">{{item.classroomName || '未分配'}} · {{item.schedule}}</text>
          </view>
        </view>

        <!-- 进度：仅显示已完成课时 -->
        <view class="progress-section">
          <view class="progress-header">
            <text class="progress-label">课程进度</text>
            <text class="progress-text">已完成 {{item.completedLessons || 0}} 课时</text>
          </view>
        </view>

        <!-- 底部：学生数 + 操作按钮 -->
        <view class="class-footer">
          <view class="student-count">
            <view class="count-visual">
              <view class="count-bar" style="width: {{(item.currentStudents / item.maxStudents) * 100}}%"></view>
            </view>
            <text class="count-text">
              <text class="count-current">{{item.currentStudents}}</text>
              <text class="count-sep">/</text>
              <text class="count-max">{{item.maxStudents}}</text>
              <text class="count-unit">人</text>
            </text>
          </view>
          
          <view class="action-buttons">
            <button 
              class="action-btn btn-students" 
              catchtap="goToStudents" 
              data-code="{{item.classCode}}"
            >
              学生
            </button>
            <button 
              class="action-btn btn-record {{item.status !== 'ACTIVE' ? 'disabled' : ''}}" 
              catchtap="goToRecordLesson" 
              data-code="{{item.classCode}}"
              disabled="{{item.status !== 'ACTIVE'}}"
            >
              记课时
            </button>
          </view>
        </view>
      </view>
    </block>

    <!-- 加载状态 -->
    <view class="loading-state" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 错误状态 -->
    <view class="error-state" wx:elif="{{error}}">
      <view class="ic ic-warn error-ic"></view>
      <text class="error-text">{{error}}</text>
      <view class="retry-btn" bindtap="loadClasses">点击重试</view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:elif="{{classes.length === 0}}">
      <view class="ic ic-list empty-ic"></view>
      <text class="empty-text">暂无班级</text>
      <text class="empty-hint">点击右下角按钮创建班级</text>
    </view>
  </view>

  <!-- 新增按钮 -->
  <view class="fab" bindtap="createClass">
    <text class="fab-icon">+</text>
  </view>
  </block>

  <!-- ========== 家长/学生视图：出勤记录 ========== -->
  <block wx:else>
    <view class="student-view">
      <!-- Loading -->
      <view wx:if="{{loading}}" class="loading-state">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载中...</text>
      </view>

      <!-- Error -->
      <view wx:elif="{{error}}" class="error-state">
        <text class="error-text">{{error}}</text>
        <view class="retry-btn" bindtap="loadStudentAttendance">重试</view>
      </view>

      <!-- Empty -->
      <view wx:elif="{{studentAllAttendance.length === 0}}" class="empty-state">
        <text class="empty-text">暂无出勤记录</text>
      </view>

      <block wx:else>
        <!-- 出勤汇总 -->
        <view class="stats-card">
          <view class="att-rate">
            <text class="att-rate-value">{{attStats.attendanceRate}}%</text>
            <text class="att-rate-label">到课率</text>
            <view class="rate-bar">
              <view class="rate-fill" style="width: {{attStats.attendanceRate}}%;"></view>
            </view>
          </view>
          <view class="att-grid">
            <view class="att-g"><text class="att-v present">{{attStats.present}}</text><text class="att-l">到课</text></view>
            <view class="att-g"><text class="att-v absent">{{attStats.absent}}</text><text class="att-l">缺勤</text></view>
            <view class="att-g"><text class="att-v late">{{attStats.late}}</text><text class="att-l">迟到</text></view>
            <view class="att-g"><text class="att-v leave">{{attStats.leave}}</text><text class="att-l">请假</text></view>
          </view>
        </view>

        <!-- 筛选标签 -->
        <view class="filter-tabs">
          <view class="filter-tab {{attFilterStatus === 'ALL' ? 'active' : ''}}" bindtap="filterStudentAttendance" data-status="ALL">全部</view>
          <view class="filter-tab {{attFilterStatus === 'PRESENT' ? 'active' : ''}}" bindtap="filterStudentAttendance" data-status="PRESENT">到课</view>
          <view class="filter-tab {{attFilterStatus === 'ABSENT' ? 'active' : ''}}" bindtap="filterStudentAttendance" data-status="ABSENT">缺勤</view>
          <view class="filter-tab {{attFilterStatus === 'LATE' ? 'active' : ''}}" bindtap="filterStudentAttendance" data-status="LATE">迟到</view>
          <view class="filter-tab {{attFilterStatus === 'LEAVE' ? 'active' : ''}}" bindtap="filterStudentAttendance" data-status="LEAVE">请假</view>
        </view>

        <!-- 出勤列表 -->
        <view class="att-list">
          <view wx:for="{{studentAttendance}}" wx:key="id" class="att-item">
            <view class="att-main">
              <view class="att-date">{{item.lessonDate || '待定'}}</view>
              <view class="att-course">{{item.courseName || '未知课程'}}</view>
            </view>
            <view class="att-right">
              <view class="att-status {{item.statusClass}}">{{item.statusText}}</view>
              <view wx:if="{{item.deductionSkippedReason}}" class="deduction-skip-badge">未扣课时</view>
            </view>
          </view>
          <view wx:if="{{studentAttendance.length === 0}}" class="empty-state">
            <text class="empty-text">无匹配记录</text>
          </view>
        </view>
      </block>
    </view>
  </block>
</view>