<!--pages/teacher/courses.wxml-->
<view class="container">
  <!-- ========== 教师/管理员视图 ========== -->
  <block wx:if="{{!isStudentView}}">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-wrapper">
      <input
        class="search-input"
        placeholder="搜索课程名称/编码/科目"
        value="{{searchKeyword}}"
        bindinput="onSearch"
      />
      <view class="clear-btn" wx:if="{{searchKeyword}}" bindtap="clearSearch"><view class="ic ic-close"></view></view>
    </view>
  </view>

  <!-- 统计信息 -->
  <view class="stats-bar" wx:if="{{!loading && filteredCourses.length > 0}}">
    <text class="stats-text">共 {{filteredCourses.length}} 门课程</text>
    <text class="stats-text" wx:if="{{searchKeyword}}">（搜索: {{searchKeyword}}）</text>
  </view>

  <!-- 课程列表 -->
  <view class="course-list">
    <block wx:for="{{filteredCourses}}" wx:key="id">
      <view class="course-card" bindtap="goToCourseDetail" data-code="{{item.courseCode}}">
        <view class="course-header">
          <text class="course-name">{{item.name}}</text>
          <text class="course-status status-{{item.status}}">
            {{item.status === 'PUBLISHED' ? '已发布' : item.status === 'DRAFT' ? '草稿' : '已归档'}}
          </text>
        </view>
        
        <view class="course-info">
          <view class="info-row">
            <text class="info-label">编码:</text>
            <text class="info-value">{{item.courseCode}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">科目:</text>
            <text class="info-value">{{item.subject}}</text>
          </view>
        </view>

        <view class="course-meta" wx:if="{{item.lessonCount || item.enrolledClasses}}">
          <view class="meta-item">
            <text class="meta-value">{{item.lessonCount || 0}}</text>
            <text class="meta-label">课时</text>
          </view>
          <view class="meta-item">
            <text class="meta-value">{{item.enrolledClasses || 0}}</text>
            <text class="meta-label">班级</text>
          </view>
        </view>
      </view>
    </block>

    <!-- 加载中状态 -->
    <view class="loading-state" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 错误状态 -->
    <view class="error-state" wx:elif="{{error}}">
      <view class="ic ic-warn error-ic"></view>
      <text class="error-text">{{error}}</text>
      <view class="retry-btn" bindtap="loadCourses">点击重试</view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{loadingMore}}">
      <text>加载更多...</text>
    </view>

    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!loading && !error && !hasMore && filteredCourses.length > 0}}">
      <text>已加载全部</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!loading && !error && filteredCourses.length === 0}}">
      <view class="ic ic-list empty-ic"></view>
      <text class="empty-text" wx:if="{{searchKeyword}}">未找到匹配的课程</text>
      <text class="empty-text" wx:else>暂无课程</text>
      <text class="empty-hint" wx:if="{{!searchKeyword}}">点击右下角按钮创建班级</text>
    </view>
  </view>

  <!-- 新增按钮 -->
  <view class="fab" bindtap="createCourse">
    <text class="fab-icon">+</text>
  </view>
  </block>

  <!-- ========== 家长/学生视图：孩子的课程 ========== -->
  <block wx:else>
    <view class="student-view">
      <!-- 加载中状态 -->
      <view class="loading-state" wx:if="{{loading}}">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载中...</text>
      </view>

      <!-- 错误状态 -->
      <view class="error-card" wx:elif="{{error}}">
        <text class="error-text">{{error}}</text>
        <text class="retry-btn" bindtap="loadStudentCourses">点击重试</text>
      </view>

      <block wx:else>
        <!-- 孩子课程/合同列表 -->
        <view class="course-item" wx:for="{{studentCourses}}" wx:key="classCode"
          bindtap="goToStudentClassDetail" data-code="{{item.classCode}}">
          <view class="ci-head">
            <view class="ci-subject">{{item.subject}}课程</view>
            <view class="ci-remain">{{item.remainingLessons || 0}}<text class="ci-unit">节</text></view>
          </view>
          <view class="ci-meta">剩余课时 · 总课时 {{item.totalLessons || 0}}</view>
          <view class="progress-track">
            <view class="progress-fill" style="width: {{item.progress}}%;"></view>
          </view>
          <view class="ci-foot">
            <text>老师：{{item.teacherName || '待分配'}}</text>
            <text>{{item.progress}}%</text>
          </view>
        </view>

        <!-- 空状态 -->
        <view class="empty-state" wx:if="{{studentCourses.length === 0}}">
          <text class="empty-text">暂无课程信息</text>
        </view>
      </block>
    </view>
  </block>
</view>