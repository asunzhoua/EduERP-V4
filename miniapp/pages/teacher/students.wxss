/* pages/teacher/students.wxss */
.container {
  padding: 20rpx;
  background: #FAF6F0;
  min-height: 100vh;
}

.search-bar {
  margin-bottom: 20rpx;
}

.search-input {
  width: 100%;
  height: 80rpx;
  padding: 0 30rpx;
  background: #ffffff;
  border-radius: var(--radius-full, 999rpx);
  font-size: 28rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(59,157,255,0.08));
}

.student-list {
  margin-top: 20rpx;
}

.student-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 24rpx;
  margin-bottom: 12rpx;
  border-radius: 24rpx;
}

.student-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #D97B3E;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
}

.student-info {
  flex: 1;
  margin-left: 20rpx;
}

.student-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.student-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #2E2A25;
}

.student-gender {
  font-size: 24rpx;
  color: #9B9084;
}

.student-detail {
  margin-top: 8rpx;
}

.school-grade {
  font-size: 24rpx;
  color: #9B9084;
}

.student-code {
  font-size: 24rpx;
  color: #EDE5DA;
}

.empty {
  text-align: center;
  padding: 60rpx;
  color: #9B9084;
}