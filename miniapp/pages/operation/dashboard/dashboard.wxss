/* pages/operation/dashboard/dashboard.wxss · 暖杏奶油 */
.dashboard {
  padding: 24rpx;
  background: var(--bg, #FAF6F0);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 加载 / 错误 */
.loading,
.error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  color: var(--faint, #9B9084);
  font-size: 28rpx;
}

.error button {
  margin-top: 24rpx;
  padding: 12rpx 40rpx;
  border: 2rpx solid var(--accent, #D97B3E);
  border-radius: 999rpx;
  color: var(--accent-deep, #A64E1D);
  background: #FFFFFF;
  font-size: 28rpx;
}

.error button::after {
  border: none;
}

/* 区块卡片 */
.section {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  color: var(--fg, #2E2A25);
}

/* 统计网格 */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  min-width: 200rpx;
  background: #FFFFFF;
  border: 2rpx solid var(--border, #EDE5DA);
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  text-align: center;
  box-sizing: border-box;
}

.stat-value {
  font-size: 42rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
  margin-bottom: 8rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}

.stat-value--accent { color: var(--accent-deep, #A64E1D); }
.stat-value--growth { color: var(--growth, #5B7A66); }
.stat-value--warning { color: var(--warning, #D98E2B); }

.stat-label {
  font-size: 24rpx;
  color: var(--muted, #6F675D);
}

/* 数据导出 */
.export-section {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
}

.export-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.export-btn {
  flex: 1;
  min-width: 200rpx;
  background: #FFFFFF;
  color: var(--accent-deep, #A64E1D);
  border: 2rpx solid var(--accent, #D97B3E);
  border-radius: 20rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.4;
}

.export-btn::after {
  border: none;
}

.export-btn:active {
  background: var(--accent-soft, #FBEEE2);
}
