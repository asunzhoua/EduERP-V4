.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 加载中 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #ddd;
  border-top-color: #1890ff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 错误状态 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.error-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.retry-btn {
  font-size: 28rpx;
  color: #1890ff;
  padding: 12rpx 40rpx;
  border: 2rpx solid #1890ff;
  border-radius: 8rpx;
}

/* 信息卡片 */
.info-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.status-tag {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
}

.status-PENDING {
  background: #fff7e6;
  color: #fa8c16;
  border: 2rpx solid #ffd591;
}

.status-APPROVED {
  background: #f6ffed;
  color: #52c41a;
  border: 2rpx solid #b7eb8f;
}

.status-REJECTED {
  background: #fff2f0;
  color: #ff4d4f;
  border: 2rpx solid #ffccc7;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
  width: 100rpx;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  text-align: right;
  flex: 1;
  margin-left: 20rpx;
}

.info-reason {
  text-align: left;
}

/* 附件 */
.file-item {
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.file-item:last-child {
  border-bottom: none;
}

.file-name {
  font-size: 26rpx;
  color: #1890ff;
}

/* 审批记录 */
.approval-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.approval-item:last-child {
  border-bottom: none;
}

.approval-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.approval-operator {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

.approval-result {
  font-size: 24rpx;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
}

.result-pass {
  background: #f6ffed;
  color: #52c41a;
}

.result-reject {
  background: #fff2f0;
  color: #ff4d4f;
}

.approval-opinion {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 6rpx;
}

.approval-time {
  display: block;
  font-size: 22rpx;
  color: #bbb;
}

/* 审批表单 */
.approve-form {
  margin-top: 20rpx;
}

.form-section {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #333;
  padding: 16rpx;
  background: #fafafa;
  border-radius: 8rpx;
  border: 2rpx solid #f0f0f0;
  box-sizing: border-box;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 8rpx;
}

/* 按钮组 */
.btn-group {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0 40rpx;
}

.btn-reject,
.btn-approve {
  flex: 1;
  font-size: 32rpx;
  border-radius: 8rpx;
  padding: 24rpx 0;
}

.btn-reject {
  background: #fff;
  color: #ff4d4f;
  border: 2rpx solid #ff4d4f;
}

.btn-approve {
  background: #1890ff;
  color: #fff;
}

.btn-reject[disabled],
.btn-approve[disabled] {
  opacity: 0.6;
}
