/* pages/operation/exception-list/exception-list.wxss · 暖杏奶油 */
.container {
  padding: 24rpx;
  background: var(--bg, #FAF6F0);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 加载中 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid var(--accent-soft, #FBEEE2);
  border-top-color: var(--accent, #D97B3E);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: var(--faint, #9B9084);
}

/* 错误状态 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.error-text {
  font-size: 28rpx;
  color: var(--muted, #6F675D);
  margin-bottom: 20rpx;
}

.retry-btn {
  font-size: 28rpx;
  color: var(--accent-deep, #A64E1D);
  padding: 12rpx 40rpx;
  border: 2rpx solid var(--accent, #D97B3E);
  border-radius: 999rpx;
}

/* 过滤栏 */
.filter-section {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
}

.filter-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.filter-row:last-child {
  margin-bottom: 0;
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 24rpx;
  color: var(--muted, #6F675D);
  background: #FFFFFF;
  border: 2rpx solid var(--border, #EDE5DA);
  border-radius: 999rpx;
}

.filter-active {
  background: var(--accent-deep, #A64E1D);
  border-color: var(--accent-deep, #A64E1D);
  color: #FFFFFF;
  font-weight: 600;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: var(--faint, #9B9084);
}

/* 异常卡片 */
.exception-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.exception-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
}

.exception-card:active {
  transform: scale(0.99);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--border, #EDE5DA);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.card-type {
  font-size: 29rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
}

.card-date {
  font-size: 24rpx;
  color: var(--faint, #9B9084);
}

.status-tag {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.status-PENDING {
  background: var(--warning-soft, #FCF0DF);
  color: #A86A17;
}

.status-APPROVED {
  background: var(--growth-soft, #EAF1EC);
  color: var(--growth-deep, #3E5B4A);
}

.status-REJECTED {
  background: var(--danger-soft, #F9E9E7);
  color: var(--danger, #C4483F);
}

.card-body {
  margin-bottom: 8rpx;
}

.card-row {
  display: flex;
  padding: 6rpx 0;
}

.row-label {
  font-size: 24rpx;
  color: var(--faint, #9B9084);
  width: 80rpx;
  flex-shrink: 0;
}

.row-value {
  font-size: 26rpx;
  color: var(--muted, #6F675D);
  flex: 1;
}

.row-value.reason {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--border, #EDE5DA);
}

.card-time {
  font-size: 22rpx;
  color: var(--faint, #9B9084);
}

.card-link {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: var(--accent-deep, #A64E1D);
  font-weight: 500;
}

.card-link .ic-chevron {
  width: 26rpx;
  height: 26rpx;
}
