/* pages/operation/parent-manage/parent-manage.wxss */
.container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.tabs {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 30rpx;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: #666666;
  padding: 18rpx 0;
  border-radius: 12rpx;
}

.tab.active {
  background: #1890ff;
  color: #ffffff;
  font-weight: 500;
}

.form-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.picker {
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333333;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  background: #fafafa;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #1890ff;
  color: #ffffff;
  font-size: 34rpx;
  border-radius: 12rpx;
  margin-top: 20rpx;
}

.tip {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}
