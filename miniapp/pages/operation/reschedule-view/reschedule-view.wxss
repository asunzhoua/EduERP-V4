/* pages/operation/reschedule-view/reschedule-view.wxss · 暖杏奶油 */
.container {
  padding: 24rpx;
  background: var(--bg, #FAF6F0);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 加载中 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid var(--accent-soft, #FBEEE2);
  border-top-color: var(--accent, #D97B3E);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: var(--faint, #9B9084);
}

/* 错误状态 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.error-text {
  font-size: 28rpx;
  color: var(--muted, #6F675D);
  margin-bottom: 20rpx;
}

.retry-btn {
  font-size: 28rpx;
  color: var(--accent-deep, #A64E1D);
  padding: 12rpx 40rpx;
  border: 2rpx solid var(--accent, #D97B3E);
  border-radius: 999rpx;
}

/* 信息卡片 */
.info-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--border, #EDE5DA);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
}

.status-tag {
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.status-PENDING {
  background: var(--warning-soft, #FCF0DF);
  color: #A86A17;
}

.status-APPROVED {
  background: var(--growth-soft, #EAF1EC);
  color: var(--growth-deep, #3E5B4A);
}

.status-REJECTED {
  background: var(--danger-soft, #F9E9E7);
  color: var(--danger, #C4483F);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 2rpx solid var(--border, #EDE5DA);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: var(--muted, #6F675D);
  flex-shrink: 0;
  width: 100rpx;
}

.info-value {
  font-size: 26rpx;
  color: var(--fg, #2E2A25);
  text-align: right;
  flex: 1;
  margin-left: 20rpx;
}

/* 关联关系卡片 */
.relation-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
}

.relation-header {
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--border, #EDE5DA);
}

.relation-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
}

.relation-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.relation-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 40rpx;
  background: var(--accent-soft, #FBEEE2);
  border-radius: 24rpx;
  border: 2rpx solid var(--accent-soft, #FBEEE2);
  width: 100%;
  box-sizing: border-box;
}

.relation-node-makeup {
  background: var(--warning-soft, #FCF0DF);
  border-color: var(--warning-soft, #FCF0DF);
}

.node-label {
  font-size: 24rpx;
  color: var(--muted, #6F675D);
  margin-bottom: 8rpx;
}

.node-value {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
}

.relation-arrow {
  font-size: 48rpx;
  color: var(--accent, #D97B3E);
  padding: 12rpx 0;
}
