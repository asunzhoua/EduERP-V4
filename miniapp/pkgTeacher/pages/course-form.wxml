<view class="container">
  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 表单 -->
  <block wx:else>
    <!-- 课程名称 -->
    <view class="form-section">
      <view class="form-label">课程名称 <text class="required">*</text></view>
      <input class="form-input" placeholder="请输入课程名称" value="{{name}}" bindinput="onNameInput" maxlength="100" />
    </view>

    <!-- 学科 -->
    <view class="form-section">
      <view class="form-label">学科 <text class="required">*</text></view>
      <view class="picker-wrapper" bindtap="openSubjectModal">
        <text class="picker-text {{subject ? '' : 'placeholder'}}">{{subjectName || '请选择学科'}}</text>
        <text class="picker-arrow">></text>
      </view>
    </view>

    <!-- 课程类型 -->
    <view class="form-section">
      <view class="form-label">课程类型 <text class="required">*</text></view>
      <picker range="{{typeNames}}" value="{{typeIndex}}" bindchange="onTypeChange">
        <view class="picker-wrapper">
          <text class="picker-text {{type ? '' : 'placeholder'}}">{{typeNames[typeIndex] || '请选择课程类型'}}</text>
          <text class="picker-arrow">></text>
        </view>
      </picker>
    </view>

    <!-- 总课时(小时) -->
    <view class="form-section">
      <view class="form-label">总课时(小时) <text class="optional">选填</text></view>
      <input class="form-input" type="digit" placeholder="如 40" value="{{totalHours}}" bindinput="onTotalHoursInput" maxlength="6" />
    </view>

    <!-- 总课次数 -->
    <view class="form-section">
      <view class="form-label">总课次数 <text class="optional">选填</text></view>
      <input class="form-input" type="number" placeholder="如 40" value="{{totalLessons}}" bindinput="onTotalLessonsInput" maxlength="4" />
    </view>

    <!-- 每节分钟数 -->
    <view class="form-section">
      <view class="form-label">每节课时长(分钟) <text class="required">*</text></view>
      <input class="form-input" type="number" placeholder="如 60" value="{{defaultDuration}}" bindinput="onDefaultDurationInput" maxlength="4" />
    </view>

    <!-- 课程描述 -->
    <view class="form-section">
      <view class="form-label">课程描述</view>
      <textarea class="form-textarea" placeholder="选填，课程介绍..." value="{{description}}" bindinput="onDescriptionInput" maxlength="500" />
    </view>

    <!-- 内部备注 -->
    <view class="form-section">
      <view class="form-label">内部备注</view>
      <textarea class="form-textarea" placeholder="选填，仅自己可见..." value="{{note}}" bindinput="onNoteInput" maxlength="200" />
    </view>

    <!-- 提交按钮 -->
    <view class="submit-section">
      <button class="submit-btn" bindtap="onSubmit" disabled="{{submitting}}">
        <text wx:if="{{!submitting}}">{{isEdit ? '保存' : '创建课程'}}</text>
        <text wx:else>提交中...</text>
      </button>
    </view>
  </block>

  <!-- 学科选择弹窗 -->
  <view class="modal-mask" wx:if="{{subjectModal}}" bindtap="closeSubjectModal">
    <view class="subject-modal" catchtap="noop">
      <view class="modal-header">
        <text class="modal-title">{{subjectAddMode ? '新增学科' : '选择学科'}}</text>
        <text class="modal-close" bindtap="closeSubjectModal">×</text>
      </view>

      <!-- 新增学科模式 -->
      <block wx:if="{{subjectAddMode}}">
        <view class="add-subject-body">
          <view class="add-row">
            <text class="add-label">学科名称</text>
            <input class="add-input" placeholder="请输入学科名称" value="{{newSubjectName}}" bindinput="onAddSubjectNameInput" maxlength="32" focus="{{true}}" />
          </view>
          <view class="add-row">
            <text class="add-label">所属分组</text>
            <picker range="{{newSubjectCategoryNames}}" value="{{newSubjectCategoryIndex}}" bindchange="onAddSubjectCategoryChange">
              <view class="add-picker">
                <text>{{newSubjectCategoryNames[newSubjectCategoryIndex]}}</text>
                <text class="picker-arrow">></text>
              </view>
            </picker>
          </view>
        </view>
        <view class="modal-actions">
          <button class="modal-btn cancel" bindtap="cancelAddSubject">取消</button>
          <button class="modal-btn primary" bindtap="confirmAddSubject" disabled="{{addingSubject}}">{{addingSubject ? '添加中...' : '确定添加'}}</button>
        </view>
      </block>

      <!-- 选择学科模式 -->
      <block wx:else>
        <scroll-view scroll-y class="subject-scroll">
          <view class="subject-group" wx:for="{{subjectGroups}}" wx:key="category" wx:for-item="group">
            <view class="group-header" bindtap="toggleSubjectGroup" data-category="{{group.category}}">
              <text class="group-label">{{group.label}}</text>
              <text class="group-arrow">{{expandedMap[group.category] ? '▾' : '▸'}}</text>
            </view>
            <view class="group-items" wx:if="{{expandedMap[group.category]}}">
              <view
                class="subject-item {{subject === item.code ? 'active' : ''}}"
                wx:for="{{group.items}}"
                wx:key="code"
                bindtap="selectSubject"
                data-code="{{item.code}}"
                data-name="{{item.name}}"
              >
                <text class="subject-item-name">{{item.name}}</text>
                <text wx:if="{{subject === item.code}}" class="subject-check">✓</text>
              </view>
            </view>
          </view>
          <view wx:if="{{!subjectGroups.length}}" class="empty-hint">学科目录加载中...</view>
        </scroll-view>
        <view class="add-subject-entry" bindtap="openAddSubject">
          <text class="add-entry-icon">＋</text>
          <text class="add-entry-text">新增学科</text>
        </view>
      </block>
    </view>
  </view>
</view>
