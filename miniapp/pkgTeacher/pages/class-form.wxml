<view class="container">
  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 表单 -->
  <block wx:else>
    <!-- 课程选择 -->
    <view class="form-section">
      <view class="form-label">课程 <text class="required">*</text></view>
      <picker range="{{courseNames}}" value="{{courseIndex}}" bindchange="onCourseChange">
        <view class="picker-wrapper">
          <text class="picker-text {{courseCode ? '' : 'placeholder'}}">
            {{courseNames[courseIndex] || '请选择课程'}}
          </text>
          <text class="picker-arrow">></text>
        </view>
      </picker>
    </view>

    <!-- 班级名称 -->
    <view class="form-section">
      <view class="form-label">班级名称 <text class="required">*</text></view>
      <input class="form-input" placeholder="请输入班级名称" value="{{name}}" bindinput="onNameInput" maxlength="50" />
    </view>

    <!-- 开课日期 -->
    <view class="form-section">
      <view class="form-label">开课日期 <text class="required">*</text></view>
      <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange" start="2020-01-01" end="2035-12-31">
        <view class="picker-wrapper">
          <text class="picker-text {{startDate ? '' : 'placeholder'}}">{{startDate || '请选择开课日期'}}</text>
          <text class="picker-arrow">></text>
        </view>
      </picker>
    </view>

    <!-- 星期多选 -->
    <view class="form-section">
      <view class="form-label">上课星期 <text class="required">*</text></view>
      <view class="day-grid">
        <view
          class="day-item {{dayOfWeek.indexOf(index) >= 0 ? 'day-active' : ''}}"
          wx:for="{{dayLabels}}"
          wx:key="*this"
          bindtap="onDayToggle"
          data-day="{{index}}"
        >
          {{item}}
        </view>
      </view>
      <text class="day-hint" wx:if="{{dayOfWeek.length > 0}}">已选：{{selectedDaysText}}</text>
    </view>

    <!-- 上课时间 -->
    <view class="form-section">
      <view class="form-label">上课时间 <text class="required">*</text></view>
      <view class="time-row">
        <picker mode="time" value="{{startTime}}" bindchange="onStartTimeChange">
          <view class="picker-wrapper time-picker">
            <text class="picker-text {{startTime ? '' : 'placeholder'}}">{{startTime || '开始时间'}}</text>
            <text class="picker-arrow">></text>
          </view>
        </picker>
        <text class="time-sep">至</text>
        <picker mode="time" value="{{endTime}}" bindchange="onEndTimeChange">
          <view class="picker-wrapper time-picker">
            <text class="picker-text {{endTime ? '' : 'placeholder'}}">{{endTime || '结束时间'}}</text>
            <text class="picker-arrow">></text>
          </view>
        </picker>
      </view>
    </view>

    <!-- 教室 -->
    <view class="form-section">
      <view class="form-label">教室</view>
      <picker range="{{classroomNames}}" value="{{classroomIndex}}" bindchange="onClassroomChange">
        <view class="picker-wrapper">
          <text class="picker-text {{classroomIndex > 0 ? '' : 'placeholder'}}">{{classroomNames[classroomIndex]}}</text>
          <text class="picker-arrow">></text>
        </view>
      </picker>
    </view>

    <!-- 人数上限 -->
    <view class="form-section">
      <view class="form-label">人数上限</view>
      <input class="form-input" type="number" placeholder="选填" value="{{maxStudents}}" bindinput="onMaxStudentsInput" maxlength="4" />
    </view>

    <!-- 备注 -->
    <view class="form-section">
      <view class="form-label">备注</view>
      <textarea class="form-textarea" placeholder="选填，班级备注信息..." value="{{note}}" bindinput="onNoteInput" maxlength="200" />
    </view>

    <!-- 提交按钮 -->
    <view class="submit-section">
      <button class="submit-btn" bindtap="onSubmit" disabled="{{submitting}}">
        <text wx:if="{{!submitting}}">{{isEdit ? '保存' : '创建班级'}}</text>
        <text wx:else>提交中...</text>
      </button>
    </view>
  </block>
</view>
