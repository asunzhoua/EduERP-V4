/* pages/teacher/course-detail.wxss */
.container {
  padding: 20rpx;
  background: #FAF6F0;
  min-height: 100vh;
}

/* 加载状态 */
.loading-state, .error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #FBEEE2;
  border-top-color: #D97B3E;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #9B9084;
  margin-top: 16rpx;
}

.error-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.error-text {
  font-size: 28rpx;
  color: #9B9084;
  margin-bottom: 20rpx;
}

.retry-btn {
  padding: 16rpx 40rpx;
  background: #D97B3E;
  color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
}

/* 详情内容 */
.detail-header {
  background: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.course-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #2E2A25;
  display: block;
  margin-bottom: 12rpx;
}

.course-code {
  font-size: 24rpx;
  color: #9B9084;
  display: block;
  margin-bottom: 16rpx;
}

.course-tags {
  display: flex;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.tag-subject {
  background: #FBEEE2;
  color: #D97B3E;
}

.tag-status-PUBLISHED {
  background: #FBEEE2;
  color: #D97B3E;
}

.tag-status-DRAFT {
  background: #FCF0DF;
  color: #D98E2B;
}

.tag-status-ARCHIVED {
  background: #FAF6F0;
  color: #9B9084;
}

/* 信息区块 */
.info-section {
  background: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #2E2A25;
  margin-bottom: 16rpx;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #FAF6F0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #6F675D;
}

.info-value {
  font-size: 26rpx;
  color: #2E2A25;
  font-weight: 500;
}

.description-text {
  font-size: 26rpx;
  color: #6F675D;
  line-height: 1.6;
}

/* 操作按钮 */
.action-section {
  padding: 20rpx 0;
}

.action-btn.primary {
  width: 100%;
  padding: 24rpx;
  background: linear-gradient(135deg, #D97B3E 0%, #A64E1D 100%);
  color: #fff;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 500;
}

/* 草稿课程：编辑/删除 */
.action-bar {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.action-bar button {
  flex: 1;
  font-size: 30rpx;
  border-radius: 24rpx;
  padding: 24rpx 0;
  line-height: 1.4;
}

.edit-btn {
  background: #D97B3E;
  color: #fff;
}

.delete-btn {
  background: #F9E9E7;
  color: #C4483F;
}