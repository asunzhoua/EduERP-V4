/* pages/teacher/class-detail.wxss */
.container {
  padding: 20rpx;
  background: #FAF6F0;
  min-height: 100vh;
}

/* 加载/错误状态 */
.loading-state, .error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #FBEEE2;
  border-top-color: #D97B3E;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #9B9084;
  margin-top: 16rpx;
}

.error-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.error-text {
  font-size: 28rpx;
  color: #9B9084;
  margin-bottom: 20rpx;
}

.retry-btn {
  padding: 16rpx 40rpx;
  background: #D97B3E;
  color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
}

/* 头部 */
.detail-header {
  background: linear-gradient(135deg, #D97B3E 0%, #A64E1D 100%);
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  color: #fff;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.class-name {
  font-size: 36rpx;
  font-weight: bold;
}

.class-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.2);
}

.class-schedule {
  font-size: 26rpx;
  opacity: 0.9;
  display: block;
  margin-bottom: 12rpx;
}

.course-info {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.course-label {
  opacity: 0.7;
  margin-right: 8rpx;
}

.course-name {
  opacity: 0.9;
}

/* Tab 栏 */
.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #6F675D;
  transition: all 0.2s;
}

.tab-item.active {
  color: #D97B3E;
  background: #FBEEE2;
  font-weight: 500;
}

/* Tab 内容 */
.tab-content {
  min-height: 400rpx;
}

/* 信息区块 */
.info-section {
  background: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #2E2A25;
  margin-bottom: 16rpx;
}

.info-list {
  display: flex;
  flex-direction: column;
}

.info-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #FAF6F0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #6F675D;
}

.info-value {
  font-size: 26rpx;
  color: #2E2A25;
  font-weight: 500;
}

/* 学生列表 */
.students-panel {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.panel-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #2E2A25;
}

.view-all {
  font-size: 24rpx;
  color: #D97B3E;
}

.student-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.student-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 16rpx;
  background: #FAF6F0;
  border-radius: 16rpx;
}

.student-name {
  font-size: 26rpx;
  color: #2E2A25;
}

.student-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.status-ENROLLED {
  background: #FBEEE2;
  color: #D97B3E;
}

.status-LEAVE {
  background: #FCF0DF;
  color: #D98E2B;
}

.empty-hint {
  text-align: center;
  padding: 40rpx;
  color: #9B9084;
  font-size: 26rpx;
}

/* 课时记录 */
.lessons-panel {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.progress-card {
  margin-bottom: 24rpx;
}

.progress-text {
  font-size: 24rpx;
  color: #6F675D;
  display: block;
  text-align: center;
}

/* 草稿班级：编辑/删除 */
.action-bar {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.action-bar button {
  flex: 1;
  font-size: 30rpx;
  border-radius: 24rpx;
  padding: 24rpx 0;
  line-height: 1.4;
}

.edit-btn {
  background: #D97B3E;
  color: #fff;
}

.delete-btn {
  background: #F9E9E7;
  color: #C4483F;
}

.record-btn {
  width: 100%;
  padding: 24rpx;
  background: linear-gradient(135deg, #D97B3E 0%, #A64E1D 100%);
  color: #fff;
  border-radius: 24rpx;
  font-size: 30rpx;
}

/* 出勤率颜色 */
.rate-good { color: #D97B3E; font-weight: bold; }
.rate-warn { color: #D98E2B; font-weight: bold; }
.rate-bad { color: #C4483F; font-weight: bold; }