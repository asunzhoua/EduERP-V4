/* pages/teacher/student-picker.wxss */
.container {
  padding: 20rpx;
  background: #FAF6F0;
  min-height: 100vh;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #2E2A25;
}

.clear-btn {
  font-size: 24rpx;
  color: #D97B3E;
  padding-left: 16rpx;
}

/* 加载/错误状态 */
.loading-state, .error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #FBEEE2;
  border-top-color: #D97B3E;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #9B9084;
  margin-top: 16rpx;
}

.error-ic {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.error-text {
  font-size: 28rpx;
  color: #9B9084;
  margin-bottom: 20rpx;
}

.retry-btn {
  padding: 16rpx 40rpx;
  background: #D97B3E;
  color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
}

/* 候选学生列表 */
.student-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.student-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.student-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #FBEEE2;
  color: #D97B3E;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.student-info {
  flex: 1;
  min-width: 0;
}

.student-header {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.student-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #2E2A25;
  margin-right: 12rpx;
}

.student-gender {
  font-size: 22rpx;
  color: #9B9084;
}

.student-detail {
  font-size: 22rpx;
  color: #9B9084;
}

.school-grade {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.student-code {
  font-size: 20rpx;
  color: #9B9084;
  margin-left: 12rpx;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #9B9084;
  font-size: 26rpx;
}
