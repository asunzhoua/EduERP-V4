/* pages/teacher/lesson-record.wxss */
.container {
  padding: 20rpx;
  background: #FAF6F0;
  min-height: 100vh;
}

/* 步骤指示器 */
.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 20rpx;
  background: #ffffff;
  margin-bottom: 20rpx;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #EDE5DA;
  color: #9B9084;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
}

.step.active .step-circle {
  background: #D97B3E;
  color: #ffffff;
}

.step-text {
  font-size: 24rpx;
  color: #9B9084;
  margin-top: 8rpx;
}

.step.active .step-text {
  color: #D97B3E;
}

.step-line {
  width: 40rpx;
  height: 4rpx;
  background: #EDE5DA;
  margin: 0 10rpx;
}

.step-line.active {
  background: #D97B3E;
}

/* 内容区 */
.step-content {
  background: #ffffff;
  padding: 20rpx;
  border-radius: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2E2A25;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.hint {
  font-size: 24rpx;
  color: #9B9084;
}

/* 全局加载 */
.loading-bar {
  text-align: center;
  padding: 20rpx;
  color: #D97B3E;
  font-size: 26rpx;
}

/* 空状态 */
.empty-hint {
  text-align: center;
  padding: 60rpx 20rpx;
  color: #9B9084;
  font-size: 28rpx;
}

/* 班级列表 */
.class-list {
  margin-top: 20rpx;
}

.class-item {
  padding: 24rpx;
  margin-bottom: 12rpx;
  background: #FAF6F0;
  border-radius: 24rpx;
  border: 2rpx solid transparent;
}

.class-item.selected {
  background: #FBEEE2;
  border-color: #D97B3E;
}

.class-item .class-name {
  display: block;
  font-size: 32rpx;
  color: #2E2A25;
}

.class-item .course-name {
  display: block;
  font-size: 24rpx;
  color: #9B9084;
  margin-top: 8rpx;
}

/* 学生列表 */
.student-list {
  margin-top: 20rpx;
}

.student-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 12rpx;
  background: #FAF6F0;
  border-radius: 24rpx;
}

.student-item.status-PRESENT {
  background: #FBEEE2;
}

.student-item.status-ABSENT {
  background: #F9E9E7;
}

.student-item.status-LATE {
  background: #FCF0DF;
}

.student-item.status-SICK {
  background: #FBEEE2;
}

.student-item.status-MAKEUP {
  background: #E0F7FF;
}

.student-item.status-ONLINE {
  background: #FBEEE2;
}

.student-item.status-OFFLINE {
  background: #FCF0DF;
}

.student-name {
  font-size: 32rpx;
  color: #2E2A25;
}

.status-badge {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

/* 表单 */
.form {
  margin-top: 20rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item.half {
  flex: 1;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #6F675D;
  margin-bottom: 12rpx;
}

.required {
  color: #C4483F;
}

.picker {
  height: 80rpx;
  padding: 0 20rpx;
  background: #FAF6F0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #2E2A25;
}

/* 表单验证错误样式 */
.has-error .picker {
  border: 2rpx solid #C4483F;
}

.picker-error {
  color: #C4483F !important;
}

.error-text {
  display: block;
  font-size: 24rpx;
  color: #C4483F;
  margin-top: 8rpx;
  padding-left: 4rpx;
}

.time-range-error {
  display: block;
  font-size: 24rpx;
  color: #C4483F;
  background: #F9E9E7;
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  margin-top: -12rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background: #FAF6F0;
  border-radius: 16rpx;
  font-size: 28rpx;
}

/* 确认卡片 */
.confirm-card {
  background: #FAF6F0;
  border-radius: 24rpx;
  padding: 24rpx;
}

.confirm-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #EDE5DA;
}

.confirm-item:last-child {
  border-bottom: none;
}

.confirm-label {
  font-size: 28rpx;
  color: #9B9084;
}

.confirm-value {
  font-size: 28rpx;
  color: #2E2A25;
  text-align: right;
  max-width: 60%;
}

/* 提交状态 */
.submit-status {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #FBEEE2;
  border-radius: 16rpx;
  text-align: center;
}

.submit-loading text {
  font-size: 26rpx;
  color: #D97B3E;
}

.submit-error {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #F9E9E7;
  border: 2rpx solid #F9E9E7;
  border-radius: 16rpx;
}

.submit-error .error-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #C4483F;
  margin-bottom: 8rpx;
}

.submit-error .error-detail {
  display: block;
  font-size: 24rpx;
  color: #6F675D;
}

/* 操作栏 */
.action-bar {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.btn-primary {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #D97B3E;
  color: #ffffff;
  border-radius: 24rpx;
  font-size: 32rpx;
  text-align: center;
}

.btn-primary:active {
  background: #A64E1D;
}

.btn-disabled {
  background: #FBEEE2 !important;
  color: #ffffff !important;
}

.btn-secondary {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #ffffff;
  color: #6F675D;
  border: 2rpx solid #EDE5DA;
  border-radius: 24rpx;
  font-size: 32rpx;
  text-align: center;
}

.btn-secondary:active {
  background: #FAF6F0;
}

/* 按钮禁用态 */
button[disabled] {
  opacity: 0.6;
}

/* 快捷考勤按钮 */
.quick-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.quick-btn {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  color: #fff;
}
.quick-btn.present {
  background: #D97B3E;
}
.quick-btn.absent {
  background: #C4483F;
}