/* pages/teacher/profile.wxss */
.container {
  padding: 20rpx;
  padding-bottom: 40rpx;
  background: var(--bg, #FAF6F0);
  min-height: 100vh;
}

/* === 加载 & 错误状态 === */
.loading-state,
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border, #EDE5DA);
  border-top-color: var(--accent, #D97B3E);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text,
.error-text {
  font-size: 28rpx;
  color: var(--faint, #9B9084);
  margin-bottom: 20rpx;
}

.retry-btn {
  font-size: 28rpx;
  background: var(--accent, #D97B3E);
  color: #fff;
  border-radius: var(--radius-sm, 16rpx);
  padding: 12rpx 40rpx;
  margin-top: 20rpx;
}

/* === 顶部个人信息 === */
.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx 30rpx 40rpx;
  background: var(--gradient-primary, linear-gradient(135deg, #E08B44 0%, #A64E1D 100%));
  border-radius: var(--radius-lg, 32rpx);
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-md, 0 8rpx 24rpx rgba(120,80,40,.12));
}

.avatar-area {
  margin-bottom: 20rpx;
}

.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.avatar-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.avatar-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
}

.profile-name {
  font-size: 38rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.profile-role {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 20rpx;
  border-radius: var(--radius-full, 999rpx);
}

/* === 基础信息卡片 === */
.info-card {
  background: var(--card, #FFFFFF);
  border-radius: var(--radius-md, 28rpx);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--fg, #2E2A25);
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--bg, #FAF6F0);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: var(--muted, #6F675D);
}

.info-value {
  font-size: 28rpx;
  color: var(--fg, #2E2A25);
  font-weight: 500;
}

/* === 班级统计 === */
.stats-card {
  background: var(--card, #FFFFFF);
  border-radius: var(--radius-md, 28rpx);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
}

.stats-grid {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 20rpx 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 20rpx;
}

.stat-number {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--accent, #D97B3E);
  margin-bottom: 8rpx;
  font-variant-numeric: tabular-nums;
}

.stat-label {
  font-size: 24rpx;
  color: var(--faint, #9B9084);
}

/* === 教学概览 === */
.overview-card {
  background: var(--card, #FFFFFF);
  border-radius: var(--radius-md, 28rpx);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
}

.overview-row {
  display: flex;
  justify-content: space-around;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--bg, #FAF6F0);
}

.overview-row:last-child {
  border-bottom: none;
}

.overview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 20rpx;
}

.overview-number {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--fg, #2E2A25);
  margin-bottom: 8rpx;
  font-variant-numeric: tabular-nums;
}

.overview-label {
  font-size: 24rpx;
  color: var(--faint, #9B9084);
}

/* === 最近课程 === */
.recent-card {
  background: var(--card, #FFFFFF);
  border-radius: var(--radius-md, 28rpx);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
}

.lesson-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--bg, #FAF6F0);
}

.lesson-item:last-child {
  border-bottom: none;
}

.lesson-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.lesson-class {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--fg, #2E2A25);
}

.lesson-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm, 16rpx);
}

.status-PLANNED {
  background: var(--accent-soft, #FBEEE2);
  color: var(--accent-deep, #A64E1D);
}

.status-TEACHING {
  background: var(--warning-soft, #FCF0DF);
  color: var(--warning, #D98E2B);
}

.status-COMPLETED {
  background: var(--growth-soft, #EAF1EC);
  color: var(--growth-deep, #3E5B4A);
}

.status-CANCELLED {
  background: var(--bg, #FAF6F0);
  color: var(--faint, #9B9084);
}

.lesson-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.lesson-topic {
  font-size: 26rpx;
  color: var(--muted, #6F675D);
}

.lesson-date {
  font-size: 24rpx;
  color: var(--faint, #9B9084);
}

/* === 快捷入口 === */
.quick-nav {
  background: var(--card, #FFFFFF);
  border-radius: var(--radius-md, 28rpx);
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-around;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 20rpx;
}

.nav-text {
  font-size: 24rpx;
  color: var(--muted, #6F675D);
}

/* === 退出登录 === */
.logout-section {
  margin-top: 40rpx;
  padding: 0 20rpx;
}

.logout-btn {
  font-size: 30rpx;
  background: var(--card, #FFFFFF);
  color: var(--danger, #C4483F);
  border: 1rpx solid var(--danger, #C4483F);
  border-radius: var(--radius-md, 28rpx);
  padding: 20rpx 0;
}
