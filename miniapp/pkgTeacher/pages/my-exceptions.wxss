.container {
  padding: 20rpx;
  background: #FAF6F0;
  min-height: 100vh;
}

/* 加载中 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #EDE5DA;
  border-top-color: #D97B3E;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #9B9084;
}

/* 错误状态 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.error-text {
  font-size: 28rpx;
  color: #9B9084;
  margin-bottom: 20rpx;
}

.retry-btn {
  font-size: 28rpx;
  color: #D97B3E;
  padding: 12rpx 40rpx;
  border: 2rpx solid #D97B3E;
  border-radius: 16rpx;
}

/* Tab 栏 */
.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #6F675D;
}

.tab-active {
  background: #D97B3E;
  color: #fff;
  font-weight: bold;
}

/* 内容区域 */
.content-area {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #9B9084;
}

/* 异常卡片 */
.exception-card,
.makeup-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #FAF6F0;
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #2E2A25;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.status-PENDING {
  background: #FCF0DF;
  color: #D98E2B;
  border: 2rpx solid #FCF0DF;
}

.status-APPROVED {
  background: #FBEEE2;
  color: #D97B3E;
  border: 2rpx solid #FBEEE2;
}

.status-REJECTED {
  background: #F9E9E7;
  color: #C4483F;
  border: 2rpx solid #F9E9E7;
}

.card-body {
  margin-bottom: 8rpx;
}

.card-info {
  display: block;
  font-size: 26rpx;
  color: #6F675D;
  padding: 4rpx 0;
}

.card-footer {
  padding-top: 8rpx;
  border-top: 1rpx solid #FAF6F0;
}

.card-time {
  font-size: 22rpx;
  color: #9B9084;
}
