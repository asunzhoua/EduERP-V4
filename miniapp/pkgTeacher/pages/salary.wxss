/* pages/teacher/salary/salary.wxss */
.container {
  padding: 20rpx;
  background: var(--bg, #FAF6F0);
  min-height: 100vh;
}

/* 加载中 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border, #EDE5DA);
  border-top-color: var(--accent, #D97B3E);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: var(--faint, #9B9084);
}

/* 错误状态 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.error-text {
  font-size: 28rpx;
  color: var(--faint, #9B9084);
  margin-bottom: 20rpx;
}

.retry-btn {
  font-size: 28rpx;
  color: var(--accent, #D97B3E);
  padding: 12rpx 40rpx;
  border: 2rpx solid var(--accent, #D97B3E);
  border-radius: var(--radius-sm, 16rpx);
}

/* 月份选择 */
.month-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card, #FFFFFF);
  border-radius: var(--radius-md, 28rpx);
  padding: 20rpx 0;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
}

.month-text {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--fg, #2E2A25);
}

.month-caret {
  width: 32rpx;
  height: 32rpx;
  color: var(--faint, #9B9084);
  margin-left: 12rpx;
  opacity: .8;
}

/* 月度汇总 */
.summary-card {
  background: var(--gradient-primary, linear-gradient(135deg, #E08B44 0%, #A64E1D 100%));
  border-radius: var(--radius-lg, 32rpx);
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-md, 0 8rpx 24rpx rgba(120,80,40,.12));
}

.summary-main {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 20rpx;
}

.summary-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.summary-amount {
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
  margin-top: 6rpx;
  font-variant-numeric: tabular-nums;
}

.summary-row {
  display: flex;
  border-top: 2rpx solid rgba(255, 255, 255, 0.25);
  padding-top: 20rpx;
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sum-num {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  font-variant-numeric: tabular-nums;
}

.sum-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}

/* 工资构成 */
.breakdown-card {
  background: var(--card, #FFFFFF);
  border-radius: var(--radius-md, 28rpx);
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
}

.breakdown-title {
  font-size: 24rpx;
  color: var(--muted, #6F675D);
  margin-bottom: 16rpx;
}

.breakdown-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 2rpx solid var(--bg, #FAF6F0);
}

.breakdown-row:last-child {
  border-bottom: none;
}

.bd-name {
  font-size: 28rpx;
  color: var(--fg, #2E2A25);
}

.bd-amount {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--fg, #2E2A25);
  font-variant-numeric: tabular-nums;
}

.bd-deduct {
  color: var(--danger, #C4483F);
}

/* 记录列表 */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: var(--faint, #9B9084);
}

.record-card {
  background: var(--card, #FFFFFF);
  border-radius: var(--radius-md, 28rpx);
  padding: 24rpx 28rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-left {
  display: flex;
  flex-direction: column;
}

.source-text {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--fg, #2E2A25);
}

.card-date {
  font-size: 22rpx;
  color: var(--faint, #9B9084);
  margin-top: 4rpx;
}

.card-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.amount {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--fg, #2E2A25);
  font-variant-numeric: tabular-nums;
}

.amount-deduct {
  color: var(--danger, #C4483F);
}

.status-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm, 16rpx);
  margin-top: 6rpx;
}

.status-PENDING {
  background: var(--warning-soft, #FCF0DF);
  color: var(--warning, #D98E2B);
}

.status-APPROVED {
  background: var(--accent-soft, #FBEEE2);
  color: var(--accent-deep, #A64E1D);
}

.status-PAID {
  background: var(--growth-soft, #EAF1EC);
  color: var(--growth-deep, #3E5B4A);
}

.status-UNKNOWN {
  background: var(--surface, #F5F1EA);
  color: var(--muted, #6F675D);
}

.card-meta {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid var(--bg, #FAF6F0);
}

.meta-text {
  font-size: 24rpx;
  color: var(--muted, #6F675D);
}

.card-remark {
  margin-top: 8rpx;
}

.remark-inline {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.remark-ic {
  width: 30rpx;
  height: 30rpx;
  color: var(--warning, #D98E2B);
  opacity: .9;
}

.remark-text {
  font-size: 22rpx;
  color: var(--warning, #D98E2B);
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 20rpx 0;
}

.load-text {
  font-size: 24rpx;
  color: var(--faint, #9B9084);
}
