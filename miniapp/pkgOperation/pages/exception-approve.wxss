/* pages/operation/exception-approve/exception-approve.wxss · 暖杏奶油 */
.container {
  padding: 24rpx;
  background: var(--bg, #FAF6F0);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 加载中 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid var(--accent-soft, #FBEEE2);
  border-top-color: var(--accent, #D97B3E);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: var(--faint, #9B9084);
}

/* 错误状态 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.error-text {
  font-size: 28rpx;
  color: var(--muted, #6F675D);
  margin-bottom: 20rpx;
}

.retry-btn {
  font-size: 28rpx;
  color: var(--accent-deep, #A64E1D);
  padding: 12rpx 40rpx;
  border: 2rpx solid var(--accent, #D97B3E);
  border-radius: 999rpx;
}

/* 信息卡片 */
.info-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--border, #EDE5DA);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
}

.status-tag {
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.status-PENDING {
  background: var(--warning-soft, #FCF0DF);
  color: #A86A17;
}

.status-APPROVED {
  background: var(--growth-soft, #EAF1EC);
  color: var(--growth-deep, #3E5B4A);
}

.status-REJECTED {
  background: var(--danger-soft, #F9E9E7);
  color: var(--danger, #C4483F);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 2rpx solid var(--border, #EDE5DA);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: var(--muted, #6F675D);
  flex-shrink: 0;
  width: 100rpx;
}

.info-value {
  font-size: 26rpx;
  color: var(--fg, #2E2A25);
  text-align: right;
  flex: 1;
  margin-left: 20rpx;
}

.info-reason {
  text-align: left;
}

/* 附件 */
.file-item {
  padding: 10rpx 0;
  border-bottom: 2rpx solid var(--border, #EDE5DA);
}

.file-item:last-child {
  border-bottom: none;
}

.file-name {
  font-size: 26rpx;
  color: var(--accent-deep, #A64E1D);
}

/* 审批记录 */
.approval-item {
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--border, #EDE5DA);
}

.approval-item:last-child {
  border-bottom: none;
}

.approval-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.approval-operator {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
}

.approval-result {
  font-size: 24rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.result-pass {
  background: var(--growth-soft, #EAF1EC);
  color: var(--growth-deep, #3E5B4A);
}

.result-reject {
  background: var(--danger-soft, #F9E9E7);
  color: var(--danger, #C4483F);
}

.approval-opinion {
  display: block;
  font-size: 24rpx;
  color: var(--muted, #6F675D);
  margin-bottom: 6rpx;
}

.approval-time {
  display: block;
  font-size: 22rpx;
  color: var(--faint, #9B9084);
}

/* 审批表单 */
.approve-form {
  margin-top: 20rpx;
}

.form-section {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
}

.form-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
  margin-bottom: 16rpx;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: var(--fg, #2E2A25);
  padding: 16rpx 20rpx;
  background: #FFFFFF;
  border: 2rpx solid var(--border, #EDE5DA);
  border-radius: 20rpx;
  box-sizing: border-box;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: var(--faint, #9B9084);
  margin-top: 8rpx;
}

/* 按钮组：拒绝=描边次级，通过=实心主 */
.btn-group {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0 40rpx;
}

.btn-reject,
.btn-approve {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border-radius: 999rpx;
  padding: 0;
}

.btn-reject::after,
.btn-approve::after {
  border: none;
}

.btn-reject {
  background: #FFFFFF;
  color: var(--danger, #C4483F);
  border: 2rpx solid var(--danger, #C4483F);
}

.btn-approve {
  background: var(--accent-deep, #A64E1D);
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(166,78,29,.25);
}

.btn-reject[disabled],
.btn-approve[disabled] {
  opacity: 0.6;
}
