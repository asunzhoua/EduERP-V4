@import "app-icons.wxss";

/* =========================================================
   EduERP 全局设计系统 · 暖杏奶油 / 优雅留白
   ---------------------------------------------------------
   设计令牌 + 通用组件类。所有页面通过 var(--xxx) 引用令牌。
   兼容旧变量名：--primary/--bg/--card/--text-* 等映射暖色，
   老页面引用不崩；页面样式随后逐页收敛到令牌。
   ========================================================= */

page {
  /* ---- 颜色 · 暖杏奶油 ---- */
  --primary: #D97B3E;          /* 主色 琥珀橙（兼容名） */
  --primary-dark: #A64E1D;     /* 主色 深 */
  --primary-soft: #FBEEE2;     /* 主色 浅底 */
  --accent: #D97B3E;           /* 强调 琥珀橙 */
  --accent-deep: #A64E1D;      /* 强调 深（按钮/文字，AA） */
  --accent-soft: #FBEEE2;      /* 强调 浅底 */
  --growth: #5B7A66;           /* 成长 墨绿 */
  --growth-soft: #EAF1EC;
  --growth-deep: #3E5B4A;
  --bg: #FAF6F0;               /* 页面底 暖米白 */
  --card: #FFFFFF;
  --surface: #FFFFFF;
  --fg: #2E2A25;               /* 主文字 暖墨 */
  --text-primary: #2E2A25;
  --muted: #6F675D;            /* 次文字 ≥5:1 */
  --text-secondary: #6F675D;
  --faint: #9B9084;            /* 占位/弱文字 ≥3:1 */
  --text-tertiary: #9B9084;
  --border: #EDE5DA;
  --danger: #C4483F;
  --danger-soft: #F9E9E7;
  --warning: #D98E2B;
  --warning-soft: #FCF0DF;
  --success: #5B7A66;
  --success-soft: #EAF1EC;

  /* ---- 圆角 ---- */
  --radius-sm: 16rpx;
  --radius-md: 28rpx;
  --radius-lg: 32rpx;
  --radius-full: 999rpx;

  /* ---- 阴影（暖色） ---- */
  --shadow-sm: 0 2rpx 8rpx rgba(120,80,40,.06);
  --shadow-md: 0 8rpx 24rpx rgba(120,80,40,.12);
  --shadow-lg: 0 16rpx 40rpx rgba(120,80,40,.18);

  /* ---- 间距 ---- */
  --space-xs: 12rpx;
  --space-sm: 20rpx;
  --space-md: 28rpx;
  --space-lg: 40rpx;

  /* ---- 渐变 ---- */
  --gradient-primary: linear-gradient(135deg, #E08B44 0%, #A64E1D 100%);
  --gradient-header: linear-gradient(160deg, #FBE6CF 0%, #FAF6F0 78%);

  /* ---- 基础 ---- */
  background: var(--bg, #FAF6F0);
  color: var(--fg, #2E2A25);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue",
    "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ============ 通用图标 ============ */
.ic {
  display: inline-block;
  width: 44rpx;
  height: 44rpx;
  vertical-align: middle;
}

.error-ic {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 12rpx;
  opacity: .7;
}

.empty-ic {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  opacity: .5;
}

/* 快捷导航图标容器（quick-nav / nav-item 内） */
.ni {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background-color: var(--accent-soft, #FBEEE2);
  margin-bottom: 10rpx;
}

/* ============ 通用容器 ============ */
.page-container {
  padding: var(--space-md);
  background: var(--bg, #FAF6F0);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ============ 通用卡片 ============ */
.card {
  background: var(--card, #FFFFFF);
  border-radius: var(--radius-md, 28rpx);
  padding: var(--space-md);
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(120,80,40,.06));
  box-sizing: border-box;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--fg, #2E2A25);
  margin-bottom: var(--space-sm);
}

/* ============ 通用按钮 ============ */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--radius-full, 999rpx);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 88rpx;
  border: none;
  padding: 0;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #A64E1D;
  color: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(166,78,29,.28);
}

.btn-primary:active {
  filter: brightness(.95);
  transform: scale(.99);
}

.btn-outline {
  background: #FFFFFF;
  color: var(--accent-deep, #A64E1D);
  border: 2rpx solid var(--accent, #D97B3E);
}

.btn-danger {
  background: var(--danger-soft, #F9E9E7);
  color: var(--danger, #C4483F);
}

.btn-ghost {
  background-color: var(--accent-soft, #FBEEE2);
  color: var(--accent-deep, #A64E1D);
}

/* ============ 通用标签 ============ */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-full, 999rpx);
  font-size: 22rpx;
  line-height: 1.4;
}

.tag-success {
  background: var(--growth-soft, #EAF1EC);
  color: var(--growth-deep, #3E5B4A);
}

.tag-warning {
  background: var(--warning-soft, #FCF0DF);
  color: #A86A17;
}

.tag-danger {
  background: var(--danger-soft, #F9E9E7);
  color: var(--danger, #C4483F);
}

.tag-neutral {
  background: #EFEAE3;
  color: var(--muted, #6F675D);
}

.tag-accent {
  background-color: var(--accent-soft, #FBEEE2);
  color: var(--accent-deep, #A64E1D);
}

/* ============ 状态角标（新） ============ */
.badge {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-full, 999rpx);
  line-height: 1.5;
}

.badge-present { background: var(--growth-soft); color: var(--growth-deep); }
.badge-absent { background: var(--danger-soft); color: var(--danger); }
.badge-leave { background: #EFEAE3; color: var(--muted); }
.badge-todo { background: #FFFFFF; color: var(--accent-deep); border: 2rpx solid var(--accent); }
.badge-done { background: #F1EDE6; color: var(--muted); }
.badge-pending { background: var(--warning-soft); color: #A86A17; }

/* ============ 通用筛选 chips（新） ============ */
.chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 30rpx;
  border-radius: var(--radius-full, 999rpx);
  font-size: 26rpx;
  background: #FFFFFF;
  color: var(--muted, #6F675D);
  border: 2rpx solid var(--border, #EDE5DA);
  line-height: 1.5;
}

.chip.on {
  background: #FFFFFF;
  color: var(--accent-deep, #A64E1D);
  border-color: var(--accent, #D97B3E);
  font-weight: 600;
}

/* ============ 分段控件（新） ============ */
.segmented {
  display: flex;
  background: #EFE7DA;
  border-radius: 24rpx;
  padding: 6rpx;
}

.segmented button {
  flex: 1;
  height: 68rpx;
  border-radius: 18rpx;
  font-size: 27rpx;
  color: var(--muted, #6F675D);
  background: transparent;
  line-height: 68rpx;
}

.segmented .on {
  background: #FFFFFF;
  color: var(--accent-deep, #A64E1D);
  font-weight: 600;
  box-shadow: var(--shadow-sm);
}

/* ============ 通用表单 ============ */
.form-input {
  width: 100%;
  height: 92rpx;
  padding: 0 var(--space-md);
  font-size: 30rpx;
  color: var(--fg, #2E2A25);
  background: #FFFFFF;
  border: 2rpx solid var(--border, #EDE5DA);
  border-radius: var(--radius-full, 999rpx);
  box-sizing: border-box;
}

.form-input:focus {
  border-color: var(--accent, #D97B3E);
  background: #FFFFFF;
}

/* ============ 通用信息行 ============ */
.cell {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-sm) 0;
  border-bottom: 2rpx solid var(--border, #EDE5DA);
}

.cell:last-child {
  border-bottom: none;
}

.cell-label {
  font-size: 28rpx;
  color: var(--muted, #6F675D);
}

.cell-value {
  font-size: 28rpx;
  color: var(--fg, #2E2A25);
  font-weight: 500;
}

/* ============ 通用区块标题（纯排版，去竖条） ============ */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-sm);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--fg, #2E2A25);
}

.section-action {
  font-size: 26rpx;
  color: var(--accent-deep, #A64E1D);
}

/* ============ 通用状态 ============ */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-lg) 0;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid var(--accent-soft, #FBEEE2);
  border-top-color: var(--accent, #D97B3E);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  margin-bottom: var(--space-sm);
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: var(--faint, #9B9084);
}

/* 骨架屏（新） */
.skeleton {
  background: linear-gradient(90deg, #F2ECE2 25%, #F8F3EB 50%, #F2ECE2 75%);
  background-size: 400% 100%;
  animation: sk 1.4s infinite;
}

@keyframes sk {
  to { background-position: -100% 0; }
}

.skeleton-line {
  height: 28rpx;
  border-radius: 12rpx;
  margin: 14rpx 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-lg) 0;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: var(--space-sm);
}

.empty-text {
  font-size: 28rpx;
  color: var(--muted, #6F675D);
}

.empty-hint {
  font-size: 24rpx;
  color: var(--faint, #9B9084);
  margin-top: 8rpx;
}

.error-card {
  background: var(--danger-soft, #F9E9E7);
  border-radius: var(--radius-md, 28rpx);
  padding: var(--space-md);
  margin: var(--space-md) 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.error-text {
  color: var(--danger, #C4483F);
  font-size: 28rpx;
}

.retry-btn {
  margin-top: var(--space-sm);
  color: var(--accent-deep, #A64E1D);
  font-size: 28rpx;
  font-weight: 600;
}

/* ============ 通用列表项 ============ */
.list-card {
  background: var(--card, #FFFFFF);
  border-radius: var(--radius-md, 28rpx);
  padding: var(--space-md);
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
}

/* ============ 通用图标底座（放 .ic 图标） ============ */
.icon-badge {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-lg, 32rpx);
  background-color: var(--accent-soft, #FBEEE2);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ============ 快捷操作栅格（新） ============ */
.quick-grid {
  display: flex;
  flex-wrap: wrap;
}

.quick-tile {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  gap: 10rpx;
}

.quick-tile .ic {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background-color: var(--accent-soft, #FBEEE2);
}

.quick-tile text {
  font-size: 22rpx;
  color: var(--muted, #6F675D);
}

/* ============ 进度条（新） ============ */
.progress-track {
  height: 14rpx;
  border-radius: 999rpx;
  background: #F1EBE1;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--accent, #D97B3E);
}

/* ============ FAB ============ */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #A64E1D;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 40rpx rgba(166,78,29,.3);
  z-index: 100;
}

.fab:active {
  transform: scale(0.95);
}

/* ============ 输入框聚焦高亮 ============ */
.input-focused {
  border-color: var(--accent, #D97B3E);
}
