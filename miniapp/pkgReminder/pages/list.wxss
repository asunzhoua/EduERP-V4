/* pages/reminder/list.wxss */
.container {
  padding: 20rpx;
  background: #FAF6F0;
  min-height: 100vh;
}

/* 顶部操作栏 */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 8rpx;
  margin-bottom: 8rpx;
}

.unread-badge {
  background: #F9E9E7;
  border: 2rpx solid #F9E9E7;
  border-radius: 20rpx;
  padding: 6rpx 20rpx;
}

.unread-text {
  font-size: 24rpx;
  color: #C4483F;
}

.mark-all-btn {
  padding: 6rpx 20rpx;
}

.mark-all-text {
  font-size: 26rpx;
  color: #D97B3E;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  transition: all 0.2s;
}

.filter-active {
  background: #D97B3E;
}

.filter-active .filter-text {
  color: #fff;
}

.filter-text {
  font-size: 26rpx;
  color: #6F675D;
}

/* 加载中 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #EDE5DA;
  border-top-color: #D97B3E;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #9B9084;
}

/* 错误 */
.error-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 30rpx;
  background: #fff;
  border-radius: 24rpx;
}

.error-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.error-text {
  font-size: 28rpx;
  color: #9B9084;
  margin-bottom: 20rpx;
}

.retry-btn {
  font-size: 28rpx;
  color: #D97B3E;
  padding: 10rpx 30rpx;
  border: 2rpx solid #D97B3E;
  border-radius: 16rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 30rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #2E2A25;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #9B9084;
}

/* 提醒列表 */
.reminder-list {
  padding-bottom: 20rpx;
}

.reminder-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  position: relative;
}

.reminder-unread {
  background: #FBEEE2;
  border-left: 6rpx solid #D97B3E;
}

/* 未读圆点 */
.unread-dot {
  position: absolute;
  top: 24rpx;
  left: 12rpx;
  width: 12rpx;
  height: 12rpx;
  background: #C4483F;
  border-radius: 50%;
}

/* 提醒内容 */
.reminder-body {
  flex: 1;
  min-width: 0;
}

.reminder-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.reminder-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2E2A25;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reminder-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.status-pending {
  background: #FCF0DF;
  color: #D98E2B;
  border: 2rpx solid #FCF0DF;
}

.status-read {
  background: #FBEEE2;
  color: #D97B3E;
  border: 2rpx solid #FBEEE2;
}

.status-dismissed {
  background: #FAF6F0;
  color: #9B9084;
  border: 2rpx solid #EDE5DA;
}

.reminder-content {
  font-size: 26rpx;
  color: #6F675D;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.reminder-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.reminder-type {
  font-size: 22rpx;
  color: #D97B3E;
  background: #FBEEE2;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
}

.reminder-time {
  font-size: 22rpx;
  color: #9B9084;
}

/* 箭头 */
.reminder-arrow {
  margin-left: 12rpx;
  flex-shrink: 0;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
  color: var(--faint, #9B9084);
  opacity: .7;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 24rpx 0;
}

.load-more-text {
  font-size: 24rpx;
  color: #9B9084;
}
