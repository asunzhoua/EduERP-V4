<!-- pages/parent/index.wxml -->
<view class="container">
  <!-- 添加学生入口 -->
  <view class="add-btn" bindtap="goToAddStudent"><text class="add-plus">＋</text>添加学生</view>

  <!-- Loading -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- Error -->
  <view wx:elif="{{error}}" class="error">
    <text>{{error}}</text>
    <button class="retry-btn" bindtap="loadChildren">重试</button>
  </view>

  <!-- Empty -->
  <view wx:elif="{{children.length === 0}}" class="empty">
    <text>暂无关联的孩子信息</text>
  </view>

  <!-- Children List -->
  <view wx:else class="children-list">
    <view 
      wx:for="{{children}}" 
      wx:key="id" 
      class="child-card"
      bindtap="goToChildDetail"
      data-id="{{item.id}}"
      data-name="{{item.name}}"
      data-studentcode="{{item.studentCode}}"
      data-school="{{item.school}}"
      data-grade="{{item.grade}}"
    >
      <view class="child-info">
        <text class="child-name">{{item.name}}</text>
        <text class="child-code">{{item.studentCode}}</text>
      </view>
      <view class="child-status">
        <text class="status-text">{{item.status || '在读'}}</text>
      </view>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-entries">
    <view class="entry-card" bindtap="goToLeaveRecords">
      <view class="entry-icon ic ic-list"></view>
      <text class="entry-text">请假记录</text>
    </view>
    <view class="entry-card" bindtap="goToSubscribe">
      <view class="entry-icon ic ic-bell"></view>
      <text class="entry-text">订阅设置</text>
    </view>
  </view>
</view>
